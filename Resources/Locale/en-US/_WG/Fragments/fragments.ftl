wg-fragment-announcer = Sector Traffic Control
# The fragment's position in its announcements; corruption never touches it.
wg-fragment-coords = ({$x}, {$y})
wg-fragment-grid-name = Monolith Fragment
wg-fragment-start-announcement = Long-range sensors are tracking a Monolith fragment falling into the sector between the Federation and Dynasty lines. Something aboard it is still alive.
wg-fragment-arrived = The Monolith fragment has come to rest near {$coords}. Its heart is beating, and the Remade are crawling out of the wretched stone to meet anyone who comes close. A timid alliance has been approved between the TSFMC and PDV in order to rid the sector of this threat.
wg-fragment-cleared = The fragment heart near {$coords} has stopped beating. No more waves will come from it, but the Remade already aboard are still dangerous.
wg-fragment-cleared-joint = The fragment heart near {$coords} has stopped beating, broken by TSF and PDV crews fighting side by side. The sector is safer for it, and relations bolster. Further allocation of resources has been rewarded to both.
wg-fragment-warning-announcement = The Monolith fragment is coming apart. In five minutes it drifts out of the sector, and whatever is still aboard goes with it.
wg-fragment-departed = The broken Monolith fragment near {$coords} has drifted out of the sector, cold and quiet at last.
wg-fragment-lost = The Monolith fragment near {$coords} has drifted out of the sector with its heart still beating. Whatever it was growing, it took with it.

# Two-tone announcement: the sender in the Monolith's colour, the text in the line's own.
wg-fragment-announcement-wrap = [font size=14][bold][color={$senderColor}]{$sender} Announcement:[/color][/font][font size=12]
    [color={$textColor}]{$message}[/color][/bold][/font]
# The second voice that follows the worst lines.
wg-fragment-voice-wrap = [font size=11][italic][color={$color}]{$message}[/color][/italic][/font]

# Words the corruption may spell out, separated by spaces.
wg-fragment-hidden-words = SEEING HUNGRY CLOSER GROWING OURS WITHIN AWAKE HOME

wg-fragment-voice-land-1 = we see you
wg-fragment-voice-land-2 = come closer
wg-fragment-voice-land-3 = it is warm inside
wg-fragment-voice-land-4 = you were always ours
wg-fragment-voice-land-5 = listen. it is singing
wg-fragment-voice-lost-1 = we will remember the way
wg-fragment-voice-lost-2 = it is not over. it is growing
wg-fragment-voice-lost-3 = we are coming home
wg-fragment-voice-lost-4 = you let us go
