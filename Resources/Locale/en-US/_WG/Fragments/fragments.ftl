wg-fragment-announcer = Sector Traffic Control
# The fragment's position in its announcements; corruption never touches it.
wg-fragment-coords = ({$x}, {$y})
wg-fragment-grid-name = Monolith Fragment
wg-fragment-start-announcement = Long-range sensors are tracking a Monolith fragment falling into the sector between the Federation and Dynasty lines. Something aboard it is still alive.
wg-fragment-arrived = The Monolith fragment has come to rest near {$coords}. Its heart is beating, and the Remade are crawling out of the wretched stone to meet anyone who comes close. A timid alliance has been approved between the TSFMC and PDV in order to rid the sector of this threat.
wg-fragment-cleared = The fragment heart near {$coords} has stopped beating. No more waves will come from it, but the Remade already aboard are still dangerous.
wg-fragment-cleared-joint = The fragment heart near {$coords} has stopped beating, broken by TSF and PDV crews fighting side by side. The sector is safer for it, and relations bolster. Further allocation of resources has been rewarded to both.
wg-fragment-warning-announcement = The Monolith fragment is coming apart. In five minutes it drifts out of the sector, and whatever is still aboard goes with it.
wg-fragment-departed = The broken Monolith fragment near {$coords} has drifted out of the sector, cold and quiet at last.
wg-fragment-lost = The Monolith fragment near {$coords} has drifted out of the sector with its heart still beating. Whatever it was growing, it took with it.
# Sent to each player paid for taking part when the heart breaks.
wg-fragment-participant-paid = The fragment heart is broken. {$amount} thalers have been deposited to your account for taking part.

# Two-tone announcement: the sender in the Monolith's colour, the text in the line's own.
wg-fragment-announcement-wrap = [font size=14][bold][color={$senderColor}]{$sender} Announcement:[/color][/font][font size=12][color={$textColor}]
    {$message}[/color][/bold][/font]
# The second voice that follows the worst lines.
wg-fragment-voice-wrap = [font size=11][italic][color={$color}]{$message}[/color][/italic][/font]

# Words the corruption may spell out, separated by spaces.
wg-fragment-hidden-words = SEEING HUNGRY CLOSER GROWING OURS WITHIN AWAKE HOME

wg-fragment-voice-land-1 = we see you
wg-fragment-voice-land-2 = come closer
wg-fragment-voice-land-3 = it is warm inside
wg-fragment-voice-land-4 = you were always ours
wg-fragment-voice-land-5 = listen. it is singing
wg-fragment-voice-lost-1 = we will remember the way
wg-fragment-voice-lost-2 = it is not over. it is growing
wg-fragment-voice-lost-3 = we are coming home
wg-fragment-voice-lost-4 = you let us go

# A greater fragment: a whole shard of the Monolith.
wg-fragment-greater-grid-name = Greater Monolith Fragment
wg-fragment-greater-start-announcement = Long-range sensors are tracking something enormous falling into the sector between the Federation and Dynasty lines: not a fragment but a whole shard of the Monolith. Its mass is bending our instruments. Whatever is aboard is awake, and there is a great deal of it.
wg-fragment-greater-arrived = The greater Monolith fragment has come to rest near {$coords}. Its heart is beating hard enough to read from orbit, and the Remade are pouring out of it in numbers we have not seen before. Both factions are authorised to fight together; no single crew should board it alone.
wg-fragment-greater-warning = The greater Monolith fragment is tearing itself apart. In five minutes it drifts out of the sector, and everything it has grown goes with it.
wg-fragment-greater-cleared = The greater fragment's heart near {$coords} has stopped beating. The waves have ended, but the shard is still crawling with Remade; clear it carefully.
wg-fragment-greater-cleared-joint = The greater fragment's heart near {$coords} has stopped beating, broken by TSF and PDV crews fighting side by side. Command on both sides is calling it the largest joint action of the war. Rewards have been released to both factions.
wg-fragment-greater-departed = The broken greater fragment near {$coords} has drifted out of the sector. Its silence is louder than its heartbeat ever was.
wg-fragment-greater-lost = The greater Monolith fragment near {$coords} has drifted out of the sector with its heart still beating. It was not dying. It was carrying something.
wg-fragment-greater-voice-land-1 = all of us. all of us are here
wg-fragment-greater-voice-land-2 = we are so many now
wg-fragment-greater-voice-land-3 = come and sing with us
wg-fragment-greater-voice-land-4 = the choir is waiting
wg-fragment-greater-voice-lost-1 = we carried it home
wg-fragment-greater-voice-lost-2 = the song goes on without you
wg-fragment-greater-voice-lost-3 = next time we will be more
