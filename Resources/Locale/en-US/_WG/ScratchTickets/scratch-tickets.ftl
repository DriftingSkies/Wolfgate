# What is printed on the card
wg-scratch-ticket-card-top-prize = WIN UP TO { $amount }!
wg-scratch-ticket-card-match = ×{ $count }
wg-scratch-ticket-card-key-left = WINNING
wg-scratch-ticket-card-key-right = SYMBOL
wg-scratch-ticket-card-game = GAME { $number }
wg-scratch-ticket-card-serial = No. CPL-{ $serial }
wg-scratch-ticket-card-dud = NOTHING
wg-scratch-ticket-card-won = WINNER! This ticket pays { $amount }.
wg-scratch-ticket-card-lost = Not a winner. Better luck on the next one.

wg-scratch-ticket-mother-lode-title = MOTHER LODE
wg-scratch-ticket-mother-lode-tagline = STRIKE THREE ORES ALIKE AND THE VEIN IS YOURS
wg-scratch-ticket-mother-lode-dud = SPOIL
wg-scratch-ticket-foundry-title = FOUNDRY GOLD
wg-scratch-ticket-foundry-tagline = FIND THE WINNING INGOT AND THE CAST IS YOURS
wg-scratch-ticket-foundry-dud = SLAG
wg-scratch-ticket-tycoon-title = THALER TYCOON
wg-scratch-ticket-tycoon-tagline = TWO ALIKE IN ANY GAME AND RETIRE A TYCOON
wg-scratch-ticket-tycoon-dud = CHANGE
wg-scratch-ticket-card-small-print-redeem = Winners are paid at any bank ATM. Void if eaten.
wg-scratch-ticket-card-small-print-issuer = Caelestinus Prospectors' Lottery

wg-scratch-ticket-examine-fresh = The foil is [color=silver]unscratched[/color].
wg-scratch-ticket-examine-won = It is a [color=gold]winner[/color], worth { $amount } at an ATM.
wg-scratch-ticket-examine-lost = It has been scratched and won [color=gray]nothing[/color].

wg-scratch-ticket-pile-no-hand = You need a free hand to pull a ticket out.

wg-scratch-ticket-atm-fresh = The ATM won't read a ticket with its foil still on.
wg-scratch-ticket-atm-lost = The ATM spits the losing ticket back out.
wg-scratch-ticket-atm-paid = The ATM takes the ticket and pays { $amount } into your account.
wg-scratch-ticket-atm-paid-cash = The ATM takes the ticket and pays out { $amount } in cash.

# Scratches-to-Win, the ticket seller in the Caelestinus Central bar
wg-scratch-seller-greeting = Tickets, tickets! One good scratch and you never haul ore again.
wg-scratch-seller-farewell = May your claws find diamonds.
wg-scratch-seller-prompt-shop = I'll take a ticket.
wg-scratch-seller-response-shop = Fresh off the roll. Pick a lucky one, or take a banded pack of ten or twenty.
wg-scratch-seller-prompt-how = How does it work?
wg-scratch-seller-response-how = Hold the ticket and rub the silver off. Every card prints how it wins and what it pays. Mother Lode wants three ores alike; it is cheap and pays often. Foundry Gold shows you a winning ingot to find among your six; it costs more and always pays back at least its price when it wins. Thaler Tycoon is three games of two, and a game with both alike wins; mostly it pays nothing, and once in a long while it pays five million. Feed a winner to any ATM and the money lands in your account.
wg-scratch-seller-prompt-who = Who are you?
wg-scratch-seller-response-who = Scratches-to-Win. I scratched one ticket, won enough to buy the whole roll, and I have been selling the rest ever since. Never found a second winner. That means they are all still in here.
