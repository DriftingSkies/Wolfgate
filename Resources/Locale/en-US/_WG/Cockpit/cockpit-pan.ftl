cmd-wg_cockpitpan-desc = Shows why the last right-click did or did not pan a cockpit view.
cmd-wg_cockpitpan-help = Usage: wg_cockpitpan

wg-cockpit-pan-none = none
wg-cockpit-pan-source-plot = {$plot}
wg-cockpit-pan-source-world = world view
wg-cockpit-pan-verdict = {$source}: {$verdict}
wg-cockpit-pan-started = pan started
wg-cockpit-pan-already-taken = refused, another handler took the click first
wg-cockpit-pan-modifier = refused, Shift, Ctrl or Alt held
wg-cockpit-pan-covered = refused, another control is over it
wg-cockpit-pan-not-world = refused, cursor not on the world view
wg-cockpit-pan-offline = refused, not connected
wg-cockpit-pan-note-unfocused = {" "}(window reported unfocused)
wg-cockpit-pan-note-window-modifiers = {" "}(window reported {$keys} held)

wg-cockpit-pan-report-state = Now: window focused {$focused}, modifiers held {$modifiers}
wg-cockpit-pan-report-none = No right-click on a cockpit view yet.
wg-cockpit-pan-report-press = Last right-click {$seconds}s ago at {$x}, {$y}; window reported modifiers {$modifiers}
wg-cockpit-pan-report-hit = Under cursor: {$control}
wg-cockpit-pan-report-no-surface = No cockpit view was under the cursor.
