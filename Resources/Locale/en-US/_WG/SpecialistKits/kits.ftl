# The vendor row of a kit: clicking it opens the gear list, and Take draws it.
wg-kit-row-closed = ▶  {$name}
wg-kit-row-open = ▼  {$name}
wg-kit-take = Take
wg-kit-take-chosen = You have already drawn your kit this round.
wg-kit-status-left = {$left} left
wg-kit-status-job = {$jobs} only
wg-kit-section-taken = {$name} ({$taken}/{$total} TAKEN)
wg-kit-contents-many = {$count}× {$name}
wg-kit-warning-cyber-arm = Its Shoulder Cannon only works with a cybernetic arm.
wg-kit-warning-organic = Its Pain Editor only works in an organic body.

# Infantry
ent-WGKitTsfAssaultman = assaultman kit (0351)
    .desc = Plate-ready M3-G4 armor with a ballistic plate, an Enforcer shotgun, breaching charges, C4, flashbangs and a Halo Burst autosurgeon. Opens the way.
ent-WGKitPdvLagimci = lağımcı kit
    .desc = Plate-ready UM5CU armor with a ballistic plate, an MLA-73 SMG, an energy cutlass, jaws of life, breaching charges, C4, flashbangs and a Halo Burst autosurgeon. Named for the Dynasty's sapper-miners.
ent-WGKitTsfAntitank = antitank missileman kit (0352)
    .desc = M3-L armor, an EMP rocket launcher with two rockets, a sidearm and a Shoulder Cannon autosurgeon. Kills mechs and fighters.
ent-WGKitPdvDarbzenci = darbzenci kit
    .desc = UL6 armor, two Panzero anti-tank launchers, a sidearm and a Shoulder Cannon autosurgeon. Named for the crews of the light darbzen gun.
ent-WGKitTsfMachineGunner = machine gunner kit (0331)
    .desc = A plate-ready ML66A harness with a ballistic plate, a Grizzly LMG with spare boxes, a telescopic shield and a Pain Editor autosurgeon. Holds the line.
ent-WGKitPdvYeniceri = yeniçeri kit
    .desc = Plate-ready UH7 armor with a ballistic plate, an LMG duffel, a telescopic shield and a Pain Editor autosurgeon. Named for the Janissaries.
ent-WGKitTsfMortarman = mortarman kit (0341)
    .desc = M3-L armor, a China Lake grenade launcher with frag rounds, smoke, binoculars and a sidearm. Fire over cover.
ent-WGKitPdvHumbaraci = humbaracı kit
    .desc = UL6 armor, a China Lake grenade launcher with frag rounds, smoke, binoculars and a sidearm. Named for the Dynasty's mortar corps.
ent-WGKitTsfScoutSniper = scout sniper kit (0317)
    .desc = An M45 ghillie suit, a Riversong rifle, binoculars, smoke and an Optical Camo autosurgeon. One target at a time.
ent-WGKitPdvTufekci = tüfekçi kit
    .desc = A UDEP thermal poncho, a sniper rifle case, binoculars, smoke and an Optical Camo autosurgeon. Named for the Dynasty's marksmen.
ent-WGKitTsfRecon = reconnaissance man kit (0321)
    .desc = XM4 armor, a Drozd SMG, a jetpack, magboots, a wearable camera, night vision and a Muscle Fibers autosurgeon. Goes in first.
ent-WGKitPdvAkinci = akıncı kit
    .desc = A CCC5 vest, a Vympel rifle, a jetpack, magboots, a wearable camera, night vision, a radio jammer and a Muscle Fibers autosurgeon. Named for the Dynasty's frontier raiders.

# Combat support
ent-WGKitTsfCombatEngineer = combat engineer kit (1371)
    .desc = Plate-ready M3-T armor with a trauma plate, a Drozd SMG, an Mk290 turret, tools, building sheets, mines, a bomb suit and a Threat Sole autosurgeon. Engineers only.
ent-WGKitPdvCebeci = cebeci kit
    .desc = Plate-ready UL6 armor with a trauma plate, an AK, a C4 bundle, mines, tools, plasteel, a bomb suit and a Threat Sole autosurgeon. Artificers only. Named for the Dynasty's armorers.
ent-WGKitTsfCorpsman = corpsman kit (HM)
    .desc = An M82b hardsuit, a sidearm, an advanced surgery duffel, a combat medkit, a compact defibrillator and blood packs. Corpsmen only.
ent-WGKitPdvCerrah = cerrah kit
    .desc = A SCAF hardsuit, a sidearm, hypopens, a nanite applicator, a combat medkit, a compact defibrillator and blood packs. Jarrah only. Named for the Dynasty's surgeons.
ent-WGKitTsfMasterAtArms = master-at-arms kit (MA)
    .desc = M3-L armor, a disabler, a stun baton, handcuffs, flashbangs, an energy shield and a Halo Stun autosurgeon. Takes prisoners alive.
ent-WGKitPdvBostanci = bostancı kit
    .desc = UL6 armor, a disabler, a stun baton, handcuffs, flashbangs, a telescopic shield and a Halo Stun autosurgeon. Named for Istanbul's guard and police.
ent-WGKitTsfLavCrewman = LAV crewman kit (0313)
    .desc = M3-L armor, a Gygax voucher, a sidearm, magboots and a Dermal Armor autosurgeon. The Marines' cavalry.
ent-WGKitPdvSipahi = sipahi kit
    .desc = UL6 armor, a Gygax voucher, a sidearm, magboots and a Dermal Armor autosurgeon. Named for the Dynasty's cavalry.

# Support
ent-WGKitTsfCulinary = culinary specialist kit (CS)
    .desc = Two MRE boxes, an electric grill and microwave flatpack, and a sidearm. Feeds the base and crews on long ops.
ent-WGKitPdvAsci = aşçı kit
    .desc = Two MRE boxes, an electric grill and microwave flatpack, and a sidearm. Named for the Janissary cooks.
ent-WGKitTsfMachinistMate = aviation machinist's mate kit (AD)
    .desc = A filled toolbox, a power drill, an industrial welder, a fuel jug and a spare mech power cage. Keeps mechs and fighters running.
ent-WGKitPdvArabaci = arabacı kit
    .desc = A filled toolbox, a power drill, an industrial welder, a fuel jug and a spare mech power cage. Named for the Dynasty's gun-carriage corps.
ent-WGKitTsfLandingSupport = landing support specialist kit (0481)
    .desc = A portable generator flatpack, a holoprojector, two ammo boxes, a portable recharger and flares. Sets up a forward base on claimed ground.
ent-WGKitPdvMenzilci = menzilci kit
    .desc = A portable generator flatpack, a holoprojector, two ammo boxes, a portable recharger and flares. Named for the keepers of the Dynasty's relay stations.

