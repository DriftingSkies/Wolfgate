wg-crew-role-chef = Chef

ent-WGMobCrewChef = chef
    .desc = Runs the galley, and would rather you didn't touch the knives.
ent-WGCrewChefPantry = galley pantry
    .desc = A freezer of the galley's ingredients. The cook draws on it, and it is topped up with the ship's provisions while he works.
ent-WGCrewChefPantryFilled = { ent-WGCrewChefPantry }
    .desc = { ent-WGCrewChefPantry.desc }
    .suffix = Filled
ent-WGCrewChefServeSpot = chef serving spot
    .desc = A galley's serving counter. The ship's chef puts his dishes out here and keeps count of what is left.

# What the chef says over the counter
wg-crew-chef-served = Order up: {$dish}!
wg-crew-chef-greet-1 = Hungry? We've got {$dish}.
wg-crew-chef-greet-2 = Help yourself, the {$dish} is fresh.
wg-crew-chef-greet-3 = Grab a plate. {$dish}, still warm.
wg-crew-chef-greet-cooking = Kitchen's open. Give me a minute and there'll be something on.
wg-crew-chef-ruined = That one's no good. Starting again.
