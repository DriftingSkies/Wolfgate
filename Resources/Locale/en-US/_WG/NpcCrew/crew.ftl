# Radio officer. Each line has numbered variants picked at random, since the radio drops a message whose exact text
# is already in flight. Every line gets $callsign.
wg-crew-radio-unnamed = Unregistered vessel
wg-crew-radio-docking-1 = {$callsign} docking at {$station}, {$port}.
wg-crew-radio-docking-2 = {$callsign} coming alongside {$station}, {$port}.
wg-crew-radio-undocking-1 = {$callsign} clear of {$station}, departing.
wg-crew-radio-undocking-2 = {$callsign} released from {$station}, departing.
wg-crew-radio-jumping-1 = {$callsign} jumping.
wg-crew-radio-jumping-2 = {$callsign} spooling the drive, jumping.
wg-crew-radio-arriving-1 = {$callsign} arriving.
wg-crew-radio-arriving-2 = {$callsign} out of the jump, arriving.
wg-crew-radio-on-station-1 = {$callsign} on station.
wg-crew-radio-on-station-2 = {$callsign} in position, on station.
wg-crew-radio-dock-aborted-1 = {$callsign} docking aborted, holding off the port.
wg-crew-radio-dock-aborted-2 = {$callsign} can't make the port, docking aborted, holding off.
# $x and $y are map coordinates; $vessel is empty or wg-crew-radio-mayday-vessel.
wg-crew-radio-mayday-1 = Mayday, mayday, {$callsign} under attack at {$x}, {$y}{$vessel}!
wg-crew-radio-mayday-2 = Mayday, mayday, mayday, {$callsign} taking fire at {$x}, {$y}{$vessel}!
wg-crew-radio-mayday-vessel = , hostile vessel {$hostile}
wg-crew-radio-boarded-1 = {$callsign}, we are being boarded!
wg-crew-radio-boarded-2 = {$callsign}, hostiles aboard, we are being boarded!
wg-crew-radio-captain-down-1 = Captain is down!
wg-crew-radio-captain-down-2 = {$callsign}, the captain is down!
wg-crew-radio-helm-down-1 = Helm is down, we're adrift!
wg-crew-radio-helm-down-2 = {$callsign}, pilot is down, we're adrift!
wg-crew-radio-all-clear-1 = {$callsign}, hostiles gone, resuming course.
wg-crew-radio-all-clear-2 = {$callsign}, all clear, hostiles gone, resuming course.

# wg_crew command
cmd-wg_crew-desc = Plans, spawns, lists and clears NPC crew on a grid.
cmd-wg_crew-help = Usage: {$command} plan <grid|here> [deckhands] | spawn <grid|here> [group] [deckhands] | spawnrole <role> [group] | list [group] | clear <group> | duty <mob> <duty> | orders <mob> hold | orders <mob> goto <x> <y> [<x> <y> ...] | orders <mob> loiter <x> <y> <radius> | orders <mob> follow <grid|here> | orders <mob> dock <grid|here> | orders <mob> undock | callsign <mob> <text...> | arena [vessel]
cmd-wg_crew-unknown = Unknown subcommand: {$sub}
cmd-wg_crew-hint-sub = <subcommand>
cmd-wg_crew-hint-role = <role>
cmd-wg_crew-hint-grid = <grid entity, or here>
cmd-wg_crew-hint-mob = <crewman entity>
cmd-wg_crew-hint-order = <order>
cmd-wg_crew-hint-callsign = <callsign>
cmd-wg_crew-hint-vessel = [vessel]
cmd-wg_crew-arena-unknown-vessel = {$vessel} is not a vessel.
cmd-wg_crew-arena-vessel-failed = Could not spawn {$vessel}.
cmd-wg_crew-arena-crew-failed = Some of {$group} could not be spawned.
cmd-wg_crew-arena-ship = {$group}: grid {$grid}, {$count} crew.
cmd-wg_crew-arena-done = Arena ready. arena-escort escorts arena-lead and arena-dock docks with it.
cmd-wg_crew-arena-exists = An arena is already running. Run "wg_crew arena clear" first.
cmd-wg_crew-arena-queue-failed = Could not queue the orders for {$group}. Run "wg_crew arena clear" to remove the arena.
cmd-wg_crew-arena-aborted = Removed {$count} ships spawned so far.
cmd-wg_crew-arena-cleared = Removed {$crew} crew and {$ships} ships of the arena.
cmd-wg_crew-arena-none = There is no arena to clear.
cmd-wg_crew-bad-radius = {$arg} is not a radius from 1 to 5000.
cmd-wg_crew-coordinate-range = {$arg} is outside the allowed range of -100000 to 100000.
cmd-wg_crew-follow-own-grid = {$name} can't follow their own grid.
cmd-wg_crew-target-other-map = The target grid is not on {$name}'s map.
cmd-wg_crew-not-on-grid = You are not on a grid.
cmd-wg_crew-not-a-grid = {$arg} is not a grid.
cmd-wg_crew-bad-number = {$arg} is not a whole number.
cmd-wg_crew-bad-decimal = {$arg} is not a number.
cmd-wg_crew-no-player = You need a body to spawn at.
cmd-wg_crew-unknown-role = Unknown crew role: {$role}
cmd-wg_crew-not-crew = {$arg} is not a crewman.
cmd-wg_crew-not-pilot = {$arg} is not a crewman who can pilot.
cmd-wg_crew-not-radio-operator = {$arg} is not a radio officer.
cmd-wg_crew-not-on-map = {$name} is not on a map.
cmd-wg_crew-dock-own-grid = {$name} can't dock with their own grid.
cmd-wg_crew-plan-header = {$count} posts on {$grid}:
cmd-wg_crew-plan-line = {$kind}: {$role} at {$x}, {$y}
cmd-wg_crew-spawned = Spawned {$count} crew in group {$group}.
cmd-wg_crew-spawned-one = Spawned {$name} ({$uid}) in group {$group}.
cmd-wg_crew-spawn-failed = Could not spawn {$role}.
cmd-wg_crew-list-line = {$uid} {$name}: {$role}, duty {$duty}, group {$group}
cmd-wg_crew-list-footer = {$count} crew.
