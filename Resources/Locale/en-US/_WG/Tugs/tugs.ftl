ent-WGLuggageTug = luggage tug
    .desc = A small sit-on electric tug for pulling luggage trolleys. Buckle in to drive it.
ent-WGLuggageTrolley = luggage trolley
    .desc = A flatbed trolley that couples behind a luggage tug. Strap a crate to it.

wg-tug-examine-trolleys = It is towing {$count} of {$max} trolleys.

wg-trolley-verb-couple = Couple to tug
wg-trolley-verb-uncouple = Uncouple
wg-trolley-verb-load = Strap crate on
wg-trolley-verb-unload = Take crate off

wg-trolley-coupled = You couple the trolley.
wg-trolley-uncoupled = You uncouple the trolley.
wg-trolley-couple-full = The tug can't pull any more trolleys.
wg-trolley-couple-far = Move the trolley right behind the tug or the last trolley.
wg-trolley-moving = Stop the tug first.
wg-trolley-load-start = You start strapping the crate on.
wg-trolley-unload-start = You start unstrapping the crate.

wg-trolley-examine-coupled = It is coupled to a tug.
wg-trolley-examine-cargo = {CAPITALIZE(THE($cargo))} is strapped to it.
