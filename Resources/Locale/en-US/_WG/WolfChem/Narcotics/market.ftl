# What the buyer at a cargo console lets on, shown only to the one selling: before a sale, for the heat it would leave
# them at, and after it.
wg-narcotics-buyer-appraise-cold = The buyer looks it over and nods.
wg-narcotics-buyer-appraise-near = The buyer looks it over and nods, slowly. Not much more than this before people talk.
wg-narcotics-buyer-appraise-warm = The buyer looks it over, then at the door. This much gets talked about, and it won't all fetch full price.
wg-narcotics-buyer-appraise-hot = The buyer keeps glancing at the door. Sell this now and it goes cheap, and customs will have your name.
wg-narcotics-buyer-sold-cold = The buyer takes it without a word.
wg-narcotics-buyer-sold-near = The buyer takes it and tells you not to come back too soon.
wg-narcotics-buyer-sold-warm = The buyer pays short and hurries you out. People are starting to talk.
wg-narcotics-buyer-sold-hot = The buyer pays short and won't meet your eye. People got a good look at you.
wg-narcotics-buyer-sold-wanted = The buyer pays short and won't meet your eye. Someone has given customs your name.

# Tips to security about a sale. They never name anyone.
wg-narcotics-tip-goods = narcotics
wg-narcotics-tip-cold = Tip-off: { $goods } changed hands at { $place }. No word on who.
wg-narcotics-tip-warm = Tip-off: { $goods } changed hands at { $place }. The seller is said to fly { INDEFINITE($ship) } { $ship }-class ship.
wg-narcotics-tip-hot = Tip-off: a lot of { $goods } changed hands at { $place }. The seller: { $who }, flying { INDEFINITE($ship) } { $ship }-class ship.
wg-narcotics-tip-hot-on-foot = Tip-off: a lot of { $goods } changed hands at { $place }. The seller: { $who }.
wg-narcotics-tip-who = { INDEFINITE($species) } { $species }
wg-narcotics-tip-who-dressed = { INDEFINITE($species) } { $species } in { INDEFINITE($clothing) } { $clothing }
wg-narcotics-tip-who-unknown = someone nobody could describe

# The warrant customs posts on a seller who sold past the hot line. The bounty board is the one place they are named.
wg-narcotics-warrant-customs = Customs
wg-narcotics-warrant = Sold { $goods } at { $place }.
wg-narcotics-warrant-paid = Customs warrant on { $name } claimed. { $amount } thlr paid to you.
