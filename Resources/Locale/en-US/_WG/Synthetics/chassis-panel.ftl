# Chassis panel: popups, the status line and the component health bands.

wg-chassis-panel-refuse-dead = Your chassis isn't running.
wg-chassis-panel-refuse-shutdown = Your chassis is shut down. Get power to it first.

wg-chassis-link-start-user = You plug into { THE($target) }'s maintenance port.
wg-chassis-link-start-target = { CAPITALIZE(THE($user)) } plugs a multitool into your maintenance port.
wg-chassis-link-done-target = { CAPITALIZE(THE($user)) } is linked into your chassis panel.

wg-chassis-isolate-done = Servos and sensors in { THE($part) } cut.
wg-chassis-restore-done = { CAPITALIZE(THE($part)) } is back online.
wg-chassis-isolate-refuse = That part can't be isolated.
wg-chassis-restore-low-power = { CAPITALIZE(THE($part)) } stays dark until power returns.

wg-chassis-detach-done = { CAPITALIZE(THE($part)) } comes off { THE($target) } in one piece.
wg-chassis-detach-done-owner = Your coupling releases. { CAPITALIZE(THE($part)) } comes off.
wg-chassis-detach-refuse = That part can't be detached.

wg-chassis-reboot-start = { CAPITALIZE(THE($target)) } locks up and reboots.
wg-chassis-reboot-done = Reboot complete. Sensor load cleared.
wg-chassis-reboot-refuse-shutdown = A shut-down chassis can't reboot.
wg-chassis-reboot-refuse-busy = Already rebooting.
wg-chassis-reboot-refuse-cooldown = The chassis can't reboot again for { $seconds } seconds.

wg-chassis-overclock-on = Servos overclocked.
wg-chassis-overclock-off = Servos back at rating.
wg-chassis-overclock-refuse-shutdown = The chassis is shut down.
wg-chassis-overclock-refuse-charge = Charge too low to overclock.
wg-chassis-overclock-refuse-heat = Core too hot to overclock.
wg-chassis-overclock-refuse-low-power = No power to overclock with.
wg-chassis-overclock-auto-off = Overclock off. { $reason }

wg-chassis-status-nominal = All systems nominal.
wg-chassis-status-shutdown = Shut down. Awaiting power.
wg-chassis-status-reboot = Rebooting...
wg-chassis-status-bay-open = Bay open. Plating loose.
wg-chassis-status-overclocked = Servos overclocked.
wg-chassis-status-low-power = Low power. One arm, crawl speed. Seat a charged cell.

