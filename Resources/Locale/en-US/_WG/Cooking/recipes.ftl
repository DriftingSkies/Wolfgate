# The guidebook's recipe cards (WGRecipeEmbed).
wg-recipe-board = [bold]Prep board:[/bold] {$items}.
wg-recipe-then-bake = [bold]Then:[/bold] bake it in the oven, and it becomes {$result}.
wg-recipe-then-fry = [bold]Then:[/bold] fry it in a pan, and it becomes {$result}.
wg-recipe-then-cook = [bold]Then:[/bold] bake it in a hearth's oven or cook it in a pan.
wg-recipe-ready = Ready as soon as it's put together.
wg-recipe-heat-alone = It can also go straight into the oven or a pan, no board needed.
wg-recipe-secret = Only a hearth that knows this recipe, like a Donk Co. microwave or range, will make it.
wg-recipe-fry = [bold]Pan:[/bold] fry {$items}.
wg-recipe-bake = [bold]Oven:[/bold] bake {$items}.
wg-recipe-chop = [bold]Prep board:[/bold] chop {$items} with a knife, for {$count ->
    [one] one piece
   *[other] {$count} pieces
}.
wg-recipe-chop-bonus = Now and then you'll find {$bonus} inside.
wg-recipe-stew = [bold]Pot:[/bold] add {$items} to a pot of boiling water.
wg-recipe-stew-combine = [bold]Pot:[/bold] stew {$items} together in a pot of boiling water.
wg-recipe-stew-serve = Ladle it out with a bowl.
wg-recipe-brew-items = [bold]Kettle:[/bold] drop {$items} into a boiling kettle.
wg-recipe-brew-powder = [bold]Kettle:[/bold] spoon a little {$powder} into a boiling kettle.

