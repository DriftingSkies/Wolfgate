ent-WGMonolithScion = monolith scion
    .desc = A black stone taller than you, cut with writing nobody can read. It hums. Everything you wire to it runs for free.
ent-WGMonolithSplinter = monolith splinter
    .desc = A sliver of black stone grown up through the deck, cut with writing. It hums, and something answers in the vents.
ent-WGMonolithTap = monolith tap
    .desc = A console wired into a Monolith. Set how hard you draw on it. A body dragged onto it quiets the stone for a while.
ent-WGCorruption = corruption
    .desc = Living tissue spreading over the deck. Fire kills it.
ent-WGRemadeSlasher = slasher
    .desc = It used to be crew. Now it has blades growing out of its back.
ent-WGRemadeSlasherEnhanced = black slasher
    .desc = A slasher grown hard and dark. Its blades go through armour.
ent-WGRemadeInfector = infector
    .desc = A winged thing with a proboscis. Kill it before it reaches the dead.

wg-monolith-tap-title = Monolith Tap
wg-monolith-tap-draw = Draw
wg-monolith-tap-draw-step = {$percent}%
wg-monolith-tap-resonance = RESONANCE {$resonance}%
wg-monolith-tap-output = Power output: {$megawatts} MW
wg-monolith-tap-no-scion = No Scion in reach.
wg-monolith-tap-barred = Too close to Frontier Outpost. The stone stays silent within 500 m of it.
wg-monolith-tap-feed-hint = Drag a corpse onto the Tap to bring resonance down.
wg-monolith-tap-refused = The stone takes nothing now. It is past that.
wg-monolith-tap-fed = The Tap draws {THE($corpse)} in. The hum drops.

wg-monolith-stage-quiet = Quiet
wg-monolith-stage-hymn = Hymn
wg-monolith-stage-growth = Growth
wg-monolith-stage-harvest = Harvest
wg-monolith-stage-rapture = Rapture
wg-monolith-stage-crescendo = Crescendo

wg-monolith-sold-alert = A monolith scion was sold at {$station}.
wg-monolith-crescendo-sender = Sector Watch
wg-monolith-crescendo-announcement = All ships: a Monolith has rooted itself. Dead crew in that area are getting back up. Do not board. Do not dock.

wg-monolith-whisper-1 = You hear singing. It stops when you listen.
wg-monolith-whisper-2 = Someone says your name, right behind you.
wg-monolith-whisper-3 = You can't remember why you came in here.
wg-monolith-whisper-4 = Join the song.
wg-monolith-whisper-5 = You know the writing on the stone. You don't remember learning it.
wg-monolith-whisper-6 = Something in the vents is breathing with you.
wg-monolith-whisper-7 = Draw more. It would be so easy.
wg-monolith-whisper-8 = The dead aren't finished.

wg-remade-writhing-1 = {CAPITALIZE(THE($corpse))} twitches.
wg-remade-writhing-2 = {CAPITALIZE(THE($corpse))} jerks violently.
wg-remade-writhing-3 = {CAPITALIZE(THE($corpse))} convulses.
wg-remade-writhing-4 = Something moves under the skin of {THE($corpse)}.
wg-remade-writhing-5 = The bones of {THE($corpse)} crack and shift.
wg-remade-writhing-6 = {CAPITALIZE(THE($corpse))} contorts horribly.
