wg-shield-stats-title = Generator stats
wg-shield-stats-generator = Generator: { $name }
wg-shield-stats-capacity = Heat capacity: { $value } (power or overload limited)
wg-shield-stats-ship-capacity = Heat capacity: { $total } (generator { $value }, hull { $hull })
wg-shield-stats-overload-limit = Overload threshold: { $value } heat
wg-shield-stats-online-repair = Cooling, field raised: { $value } heat/s
wg-shield-stats-offline-repair = Cooling, recharging: { $value } heat/s
wg-shield-stats-idle-power = Idle power: { $value } kW
wg-shield-stats-max-power = Maximum power: { $value } kW
wg-shield-stats-overload-lockout = Overload lockout: { $value } s after heat drops below the threshold.
wg-shield-stats-recovery-note = Heat per point of absorbed damage: { $rate }. Power demand rises with heat. The shield panel shows the live recovery estimate.
wg-shield-stats-costs = Raised field: -{ $thrust }% thrust, -{ $turn }% turning, larger sensor signature. A collapse locks guns for { $seconds } s.
wg-shield-stats-no-costs = Raised field: no thrust, turning or gun penalties.
wg-shield-stats-vent = Cooling, venting: { $value } heat/s. Shields down and guns offline until heat reaches zero.
wg-shield-stats-ship-cooling = Cooling: { $value } heat/s field raised (hull { $hull }), { $down } heat/s field down. Absorbed heat is held under a raised field until { $hold } s pass without a hit.
wg-shield-stats-cooling = Cooling: { $value } heat/s field raised, { $down } heat/s field down. Absorbed heat is held under a raised field until { $hold } s pass without a hit.
