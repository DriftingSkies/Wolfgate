# Wolfgate admin mass scanner

wg-admin-radar-title = Admin Mass Scanner
wg-admin-radar-maximize = Maximize
wg-admin-radar-maximize-tooltip = Fill the game window. The pop-out button puts the scanner on another monitor.
wg-admin-radar-ring = { $metres }m

wg-admin-radar-true-iff = True IFF
wg-admin-radar-true-iff-tooltip = Show every grid and beacon under its real name and colour, whatever its IFF hides and however far away it is, and every planet site by name, found or not.

wg-admin-radar-players = Players
wg-admin-radar-players-tooltip = Mark every player on this map.
wg-admin-radar-player-group = { $name } +{ $count }


wg-admin-radar-jump = Jump to player
wg-admin-radar-jump-tooltip = Pick a player to warp to. Enter takes the first match.
wg-admin-radar-jump-search = Search players
wg-admin-radar-jump-empty = No players
wg-admin-radar-jump-entry = { $name } ({ $username })
wg-admin-radar-jump-entry-ghost = { $name } ({ $username }), ghost
