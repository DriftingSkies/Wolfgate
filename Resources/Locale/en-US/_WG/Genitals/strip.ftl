# Undergarment removal by other players (SharedUndergarmentStripSystem). Only the actor and the target see the popups.

wg-verb-category-undergarments = Undergarments

wg-undergarment-verb-remove-top = Remove undergarment (top)
wg-undergarment-verb-remove-bottom = Remove undergarment (bottom)
wg-undergarment-verb-replace-top = Put back undergarment (top)
wg-undergarment-verb-replace-bottom = Put back undergarment (bottom)

wg-undergarment-start-user = You start removing { THE($target) }'s undergarment.
wg-undergarment-start-target = { CAPITALIZE(THE($user)) } is removing your undergarment.
wg-undergarment-done-user = You remove { THE($target) }'s undergarment.
wg-undergarment-done-target = { CAPITALIZE(THE($user)) } removed your undergarment.

wg-undergarment-replace-start-user = You start putting back { THE($target) }'s undergarment.
wg-undergarment-replace-start-target = { CAPITALIZE(THE($user)) } is putting back your undergarment.
wg-undergarment-replace-done-user = You put back { THE($target) }'s undergarment.
wg-undergarment-replace-done-target = { CAPITALIZE(THE($user)) } put back your undergarment.

# Shown to the actor only. The consent reason is deliberately generic.
wg-undergarment-fail-covered = Clothing is in the way.
wg-undergarment-fail-consent = You cannot do that right now.
wg-undergarment-fail-cooldown = Wait a moment before trying again.
