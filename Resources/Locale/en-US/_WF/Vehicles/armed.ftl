# The armed roster: names of the pre-armed vehicles an admin can spawn and of the loadouts that fit them.

ent-WFVehicleTankArmed = tank (armed)
    .desc = A heavy armored tank with an LTB cannon and an M56 cupola on its turret and a smoke launcher on its support mount.
ent-WFVehicleTankTurretArmed = tank turret (armed)
    .desc = A tank turret with an LTB cannon and an M56 cupola.

ent-WFVehicleAPCArmed = armored personnel carrier (armed)
    .desc = A rugged armored personnel carrier with a dual cannon, a frontal cannon, a flare launcher and two port guns.
ent-WFVehicleAPCTrackedArmed = armored personnel carrier (armed, tracked)
    .desc = A rugged armored personnel carrier with a dual cannon, a frontal cannon, a flare launcher and two port guns.
ent-WFVehicleAPCMedArmed = armored personnel carrier (armed, medical)
    .desc = A medical-configured APC with a dual cannon, a frontal cannon, a flare launcher and two port guns.
ent-WFVehicleAPCCommandArmed = armored personnel carrier (armed, command)
    .desc = A command-configured APC with a dual cannon, a frontal cannon, a flare launcher and two port guns.

ent-WFVehicleHumveeARCArmed = humvee (armed, arc)
    .desc = A humvee configured for the ARC interior layout, with a roof turret carrying its burst cannon.
