ent-ParaFloraCornStalkAlt2 = corn stalk
ent-ChompFloraTyrLilly = flora
    .desc = A strange plant.
ent-PolarisFloraSifFrostbelle = frostbelle shrub
    .desc = A stocky plant with fins bearing luminescent veins along its branches.
