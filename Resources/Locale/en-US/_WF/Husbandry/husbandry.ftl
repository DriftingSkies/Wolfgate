wf-lasso-throw = {CAPITALIZE(THE($user))} swings a lasso at {THE($animal)}.
wf-lasso-one-more = The loop is over {THE($animal)}, but it's still pulling hard. Throw another.
wf-lasso-tied = You have {THE($animal)} on the rope.
wf-lasso-released = You let {THE($animal)} off the rope.

wf-tame-fed = {CAPITALIZE(THE($animal))} eats from your hand ({$fed}/{$feeds}).
wf-tame-tamed = {CAPITALIZE(THE($animal))} trusts you now.

wf-herd-verb-follow = Whistle: follow me
wf-herd-verb-stay = Whistle: stay
wf-herd-verb-pen = Whistle: to the pen
wf-herd-follow = You whistle, and {$count} {$count ->
    [one] animal follows
   *[other] animals follow
} you.
wf-herd-stay = You whistle, and {$count} {$count ->
    [one] animal stays
   *[other] animals stay
} put.
wf-herd-pen = You whistle, and {$count} {$count ->
    [one] animal heads
   *[other] animals head
} for the pen.
wf-herd-none = You whistle, but nothing comes.
