## Combat music tracks: name, flavour line and credits.

wf-combat-track-mobster = Relentless Mobster
wf-combat-track-mobster-desc = Heads will roll.
wf-combat-track-mobster-credits = Roller Mobster - RudolVe

wf-combat-track-unholy = Profane Wanderer
wf-combat-track-unholy-desc = You are the scourge of the righteous, the bane of the faithful. Make them bleed.
wf-combat-track-unholy-credits = Unholy - RudolVe

wf-combat-track-vitamass = Vitae Mass
wf-combat-track-vitamass-desc = Blood poured, blood spilled, blood shed. The world is a better place for it.
wf-combat-track-vitamass-credits = Vitamass - RudolVe

wf-combat-track-ascended = Prime Ascendant
wf-combat-track-ascended-desc = The song sang. Nothing mortal is left to return.
wf-combat-track-ascended-credits = TO PIERCE THE BLACK SKY - ENVY INTERLUDE

wf-combat-track-desert-rider = Hired Gun
wf-combat-track-desert-rider-desc = Half up front, half when the hull stops venting. Loyalty costs extra.
wf-combat-track-desert-rider-credits = Two Fingers - You Ain't Down

wf-combat-track-meat-grinder = Remade Grinder
wf-combat-track-meat-grinder-desc = They get back up. Put them down again. Loud.
wf-combat-track-meat-grinder-credits = OTXO OST - Devil's Meat Grinder

wf-combat-track-high-grain = Anchor Guard
wf-combat-track-high-grain-desc = Nothing gets past you. The Lattice holds because you do.
wf-combat-track-high-grain-credits = Half-Lyfe - APC Cannon (Extended)

wf-combat-track-iconoclast = Iconoclast
wf-combat-track-iconoclast-desc = They kneel to a black stone. Show them how it breaks.
wf-combat-track-iconoclast-credits = Lateralis - Valley of Judgement

wf-combat-track-malpractice = Malpractice
wf-combat-track-malpractice-desc = You swore an oath to do no harm. The oath had exceptions.
wf-combat-track-malpractice-credits = Pathologic - Utroba Aggression

wf-combat-track-beggar = Hull Rat
wf-combat-track-beggar-desc = No ship, no Writ, nothing left to lose. Kick, scratch, bite.
wf-combat-track-beggar-credits = Pathologic (Classic) - Most Combat Theme

wf-combat-track-stress = Feedback
wf-combat-track-stress-desc = The Lattice does not reach here. Neither does anything that could calm you down.
wf-combat-track-stress-credits = Thomas Bangalter - Stress

wf-combat-track-nite-creecher = Past the Anchors
wf-combat-track-nite-creecher-desc = They were told what lives out here. Now they meet it.
wf-combat-track-nite-creecher-credits = Half-Lyfe - Diabolical Adrenaline Horror

wf-combat-track-fahkeet = Stim Abuse
wf-combat-track-fahkeet-desc = Your heart is a drive coil and the needle is in the red. Loud.
wf-combat-track-fahkeet-credits = Light Club - FAHKEET

wf-combat-track-dogmatica = Dissonance
wf-combat-track-dogmatica-desc = The clocks disagree. The walls disagree. You stopped asking. Loud.
wf-combat-track-dogmatica-credits = FEMTANYL - DOGMATICA

wf-combat-track-butchers-boulevard = Bench Enforcer
wf-combat-track-butchers-boulevard-desc = The Bench has ruled. You are how the ruling arrives.
wf-combat-track-butchers-boulevard-credits = Kristjan Thomas Haaristo - Butcher's Boulevard

wf-combat-track-system-command = Command Deck
wf-combat-track-system-command-desc = The ship is lying to you. Shoot anyway.
wf-combat-track-system-command-credits = System Shock 2 - Command 2

wf-combat-track-system-hydroponics = Overgrowth
wf-combat-track-system-hydroponics-desc = The hull is warm and the walls are breathing. Cut it out before it roots.
wf-combat-track-system-hydroponics-credits = System Shock 2 - Hydroponics 1

wf-combat-track-airfield = Marine Line
wf-combat-track-airfield-desc = Hold the line. If the line moves, hold it there.
wf-combat-track-airfield-credits = Deus Ex - Lebedev's Airfield (Combat)

wf-combat-track-helipad = Helipad
wf-combat-track-helipad-desc = No extraction is coming. Make one.
wf-combat-track-helipad-credits = Deus Ex - Hong Kong Helipad (Combat)

wf-combat-track-battle01 = Fleet Action
wf-combat-track-battle01-desc = Guns out. Engines hot.
wf-combat-track-battle01-credits = Homeworld 2 - Battle 01

wf-combat-track-let-there-be-chaos = Let There Be Chaos
wf-combat-track-let-there-be-chaos-desc = Take what you can. Give nothing back.
wf-combat-track-let-there-be-chaos-credits = Ksho - Let There Be Chaos

wf-combat-track-adjudicator = Adjudicator
wf-combat-track-adjudicator-desc = The Bench weighs every plea. Yours came up light.
wf-combat-track-adjudicator-credits = Chivalry 2 OST - Duty and Honor II

wf-combat-track-imperium = Lattice Zealot
wf-combat-track-imperium-desc = Six anchors hold back the song. You hold the line in front of them.
wf-combat-track-imperium-credits = Jesper Kyd - Light of the Imperium

wf-combat-track-eyes-of-the-wolf = Unmoored
wf-combat-track-eyes-of-the-wolf-desc = It took your sleep, your crew, your certainty. It left you this.
wf-combat-track-eyes-of-the-wolf-credits = Mikolai Stroinski - Eyes of the Wolf

wf-combat-track-hunt-or-be-hunted = Hunt or Be Hunted
wf-combat-track-hunt-or-be-hunted-desc = Warm vents, cold trail. Out here everything is prey to something.
wf-combat-track-hunt-or-be-hunted-credits = The Witcher 3 OST - Hunt or Be Hunted

wf-combat-track-stoneshard9 = Hardsuit
wf-combat-track-stoneshard9-desc = Scored plate, patched seals, one good arm. Still standing.
wf-combat-track-stoneshard9-credits = Stoneshard OST - Track 9

wf-combat-track-sons-of-tyr = Contractor
wf-combat-track-sons-of-tyr-desc = Your attitude is intolerable and your smile is disgusting. You're hired.
wf-combat-track-sons-of-tyr-credits = Helbrede - Sons of Tyr

wf-combat-track-elddansurin = Unison
wf-combat-track-elddansurin-desc = Drums older than the Collapse. Every heart on deck keeps the same time.
wf-combat-track-elddansurin-credits = Heilung - Elddansurin

wf-combat-track-apab = Scion-Drinker
wf-combat-track-apab-desc = Draw harder. The stone gives more. Don't ask what it's counting.
wf-combat-track-apab-credits = burialgoods - APAB (All Paladins Are Bastards)

wf-combat-track-tense-combat = Greenhorn
wf-combat-track-tense-combat-desc = First fight past the docking ring. Breathe. Safety off.
wf-combat-track-tense-combat-credits = Dragon's Dogma OST - Tense Combat

wf-combat-track-tatar-theme = Outrider
wf-combat-track-tatar-theme-desc = Fast in, fast out, nothing left standing.
wf-combat-track-tatar-theme-credits = Hellish Quart OST - Tatar Theme

wf-combat-track-the-heathen = Siege of Kyphrus
wf-combat-track-the-heathen-desc = Kyphrus fell one corridor at a time. So will this.
wf-combat-track-the-heathen-credits = Jan J. Mocnik - The Heathen

wf-combat-track-svanrand = Hulk Raider
wf-combat-track-svanrand-desc = Dark hull, dead crew, a stone humming on the deck. Take everything else.
wf-combat-track-svanrand-credits = Heilung - Svanrand

wf-combat-track-stoneshard5 = Vigilante
wf-combat-track-stoneshard5-desc = The Bench is far away. You are right here.
wf-combat-track-stoneshard5-credits = Stoneshard OST - Track 5

wf-combat-track-iberia-war = Warlord
wf-combat-track-iberia-war-desc = Colossus has no borders. Only what you can hold.
wf-combat-track-iberia-war-credits = Hakan Glante - Fate of Iberia: War

wf-combat-track-studzianki = Fighter Wing
wf-combat-track-studzianki-desc = Break formation on my mark. Make the void burn.
wf-combat-track-studzianki-credits = Andrius Klimka & Andrey Kulik - Studzianki

wf-combat-track-cante-de-los-muertos = Remade Champion
wf-combat-track-cante-de-los-muertos-desc = It begged to stay dead. The song did not listen.
wf-combat-track-cante-de-los-muertos-credits = Carlos Viola - Cante de los Muertos
