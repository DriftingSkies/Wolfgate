wf-chimera-original-body-drop = {CAPITALIZE(THE($body))} spills out of the dead fleshbeast!
wf-chimera-greeting = You are a chimera. Out loud you can only growl. To talk to other chimeras, pick Collective Mind in the chat channel selector (Tab cycles it) or start a message with +. Only chimeras hear it.
wf-chimera-turn-cooldown-time = {$minutes ->
    [0] {$seconds} s
   *[other] {$minutes} min {$seconds} s
}
wf-chimera-turn-cooldown-message = Your body is too spent for the flesh to take it again. Letoferol can't turn you for {$time}.
wf-chimera-turn-cooldown-examine = [color=#a84387]The flesh has just let go of this body. Letoferol can't turn it again for {$time}.[/color]
wf-reagent-effect-condition-guidebook-chimera-turn-ready = the target didn't fall out of a dead fleshbeast in the last few minutes
