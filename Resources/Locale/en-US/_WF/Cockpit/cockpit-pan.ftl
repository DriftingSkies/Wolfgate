cmd-wf_cockpitpan-desc = Shows why the last right-click did or did not pan a cockpit view.
cmd-wf_cockpitpan-help = Usage: wf_cockpitpan

wf-cockpit-pan-none = none
wf-cockpit-pan-source-plot = {$plot}
wf-cockpit-pan-source-world = world view
wf-cockpit-pan-verdict = {$source}: {$verdict}
wf-cockpit-pan-started = pan started
wf-cockpit-pan-already-taken = refused, another handler took the click first
wf-cockpit-pan-modifier = refused, Shift, Ctrl or Alt held
wf-cockpit-pan-covered = refused, another control is over it
wf-cockpit-pan-not-world = refused, cursor not on the world view
wf-cockpit-pan-offline = refused, not connected
wf-cockpit-pan-note-unfocused = {" "}(window reported unfocused)
wf-cockpit-pan-note-window-modifiers = {" "}(window reported {$keys} held)

wf-cockpit-pan-report-state = Now: window focused {$focused}, modifiers held {$modifiers}
wf-cockpit-pan-report-none = No right-click on a cockpit view yet.
wf-cockpit-pan-report-press = Last right-click {$seconds}s ago at {$x}, {$y}; window reported modifiers {$modifiers}
wf-cockpit-pan-report-hit = Under cursor: {$control}
wf-cockpit-pan-report-no-surface = No cockpit view was under the cursor.
