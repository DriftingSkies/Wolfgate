// Light bloom, last pass. Screen-blends the blurred glow over the lit screen, which brightens toward white without
// clipping what is already bright.

light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D bloom_texture;     // Half the viewport's size.
uniform highp vec2 bloom_pixel_size; // 1 / the bloom texture's size in pixels.
uniform highp float strength;

void fragment() {
    highp vec4 screen = zTextureSpec(SCREEN_TEXTURE, FRAGCOORD.xy * SCREEN_PIXEL_SIZE);
    highp vec3 glow = zTextureSpec(bloom_texture, FRAGCOORD.xy * 0.5 * bloom_pixel_size).rgb;
    glow = min(glow * strength, vec3(1.0));

    COLOR = vec4(screen.rgb + glow - screen.rgb * glow, screen.a);
}
