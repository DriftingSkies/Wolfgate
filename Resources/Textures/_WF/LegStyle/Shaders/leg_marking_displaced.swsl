// displacement.swsl, cut to the outline of the leg and foot the marking belongs to. A clothing map pulls both
// legs of a side view from where the one plantigrade leg stood, so without the cut a leg marking shows on both.
uniform sampler2D displacementMap;
uniform highp float displacementSize;
uniform highp vec4 displacementUV;
uniform sampler2D legMask;
uniform highp vec4 legMaskUV;
uniform sampler2D footMask;
uniform highp vec4 footMaskUV;

varying highp vec2 displacementUVOut;
varying highp vec2 legMaskUVOut;
varying highp vec2 footMaskUVOut;

void vertex() {
    displacementUVOut = mix(displacementUV.xy, displacementUV.zw, tCoord2);
    legMaskUVOut = mix(legMaskUV.xy, legMaskUV.zw, tCoord2);
    footMaskUVOut = mix(footMaskUV.xy, footMaskUV.zw, tCoord2);
}

void fragment() {
    highp vec4 displacementSample = texture2D(displacementMap, displacementUVOut);
    highp vec2 displacementValue = (displacementSample.xy - vec2(128.0 / 255.0)) / (1.0 - 128.0 / 255.0);
    COLOR = zTexture(UV + displacementValue * TEXTURE_PIXEL_SIZE * displacementSize * vec2(1.0, -1.0));
    COLOR.a *= displacementSample.a;
    COLOR.a *= max(texture2D(legMask, legMaskUVOut).a, texture2D(footMask, footMaskUVOut).a);
}
