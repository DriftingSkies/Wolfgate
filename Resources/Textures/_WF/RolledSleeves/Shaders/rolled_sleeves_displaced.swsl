// displacement.swsl with the rolled-sleeves mask on top, for species and body types that displace jumpsuits.
uniform sampler2D displacementMap;
uniform highp float displacementSize;
uniform highp vec4 displacementUV;
uniform sampler2D rollMask;
uniform highp vec4 rollMaskUV;

varying highp vec2 displacementUVOut;
varying highp vec2 rollMaskUVOut;

void vertex() {
    displacementUVOut = mix(displacementUV.xy, displacementUV.zw, tCoord2);
    rollMaskUVOut = mix(rollMaskUV.xy, rollMaskUV.zw, tCoord2);
}

void fragment() {
    highp vec4 displacementSample = texture2D(displacementMap, displacementUVOut);
    highp vec2 displacementValue = (displacementSample.xy - vec2(128.0 / 255.0)) / (1.0 - 128.0 / 255.0);
    highp vec4 mask = texture2D(rollMask, rollMaskUVOut);
    highp vec2 offset = floor(mask.gb * 255.0 + 0.5) - vec2(128.0);

    COLOR = zTexture(UV + (displacementValue * displacementSize + offset) * TEXTURE_PIXEL_SIZE * vec2(1.0, -1.0));
    COLOR.a *= displacementSample.a;

    highp float shade = mask.r * 2.0 - 1.0;
    COLOR.rgb = shade > 0.0 ? mix(COLOR.rgb, vec3(1.0), shade * 0.25) : COLOR.rgb * (1.0 + shade * 0.5);
    COLOR.a *= mask.a;
}
