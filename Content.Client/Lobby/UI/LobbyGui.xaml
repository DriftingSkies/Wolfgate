    <!-- WOLFGATE(RoundSetup) START: a unified preparation screen with character, crew and communication areas -->
    <PanelContainer Name="HomeBackdrop" StyleClasses="WFRoundSetupBackdrop" HorizontalExpand="True" VerticalExpand="True" />
    <BoxContainer Name="MainContainer" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                  Margin="20 16" SeparationOverride="12">
        <roundSetup:WFLobbyLayout Name="LobbyWorkspace" DockChat="True" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="LeftSide" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="DefaultState" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="16">
                    <BoxContainer Name="HeaderContainer" Access="Public" Orientation="Vertical" SeparationOverride="4">
                        <Label Text="{Loc 'wf-round-setup-home-eyebrow'}" StyleClasses="WFRoundSetupEyebrow" />
                        <RichTextLabel Name="ServerName" Access="Public" StyleClasses="WFRoundSetupTitle" HorizontalExpand="True" />
                        <Label Name="StartTime" Access="Public" StyleClasses="WFRoundSetupMuted" />
                    </BoxContainer>
                    <PanelContainer Name="CharacterCard" StyleClasses="WFRoundSetupCard" SetWidth="280" HorizontalAlignment="Left" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="16" SeparationOverride="10" HorizontalExpand="True">
                            <Label Text="{Loc 'wf-round-setup-home-character'}" StyleClasses="WFRoundSetupEyebrow" />
                            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" HorizontalExpand="True" />
                            </ScrollContainer>
                            <Button Name="CustomizeButton" Access="Public" Text="{Loc 'wf-round-setup-home-customize'}" MinHeight="36" />
                            <RichTextLabel Name="NormalJoinHelp" Access="Public" StyleClasses="WFRoundSetupMuted" HorizontalExpand="True" />
                            <Button Name="RoundSetupButton" Access="Public" Text="{Loc 'wf-round-setup-home-setup'}" MinHeight="40" />
                            <Button Name="ReadyButton" Access="Public" Text="{Loc 'wf-round-setup-home-ready'}" MinHeight="64" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
                <Control Name="CharacterSetupState" Access="Public" Visible="False" HorizontalExpand="True" VerticalExpand="True" />
            </BoxContainer>
            <PanelContainer Name="RightSide" Access="Public" StyleClasses="WFRoundSetupCard" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                    <Label Text="{Loc 'wf-round-setup-home-comms'}" StyleClasses="WFRoundSetupEyebrow" />
                    <roundSetup:WFLobbyLayout Name="LobbyInformationSplit" VerticalSplit="True" HorizontalExpand="True" VerticalExpand="True">
                        <widgets:ChatBox Name="Chat" Access="Public" HorizontalExpand="True" VerticalExpand="True" MinSize="0 50" />
                        <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="12">
                                <BoxContainer Name="VoteContainer" Access="Public" Orientation="Vertical" SeparationOverride="6" />
                                <Label Text="{Loc 'wf-round-setup-home-briefing'}" StyleClasses="WFRoundSetupHeading" />
                                <info:ServerInfo Name="ServerInfo" Access="Public" StyleClasses="LobbyInfo" />
                            </BoxContainer>
                        </ScrollContainer>
                    </roundSetup:WFLobbyLayout>
                </BoxContainer>
            </PanelContainer>
        </roundSetup:WFLobbyLayout>
        <PanelContainer Name="LobbyUtilities" StyleClasses="WFRoundSetupCard" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="12 8" SeparationOverride="6">
                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public" Text="{Loc 'ui-lobby-observe-button'}"
                                        WindowType="{x:Type lobbyUi:ObserveWarningWindow}" HorizontalExpand="True" MinHeight="34" />
                    <vote:VoteCallMenuButton Name="CallVoteButton" HorizontalExpand="True" MinHeight="34" />
                    <Button Name="OptionsButton" Access="Public" Text="{Loc 'ui-lobby-options-button'}" HorizontalExpand="True" MinHeight="34" />
                    <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-nav-button'}" HorizontalExpand="True" MinHeight="34" />
                    <Button Name="LeaveButton" Access="Public" Text="{Loc 'ui-lobby-leave-nav-button'}" HorizontalExpand="True" MinHeight="34" />
                </BoxContainer>
                <ScrollContainer VScrollEnabled="False" HScrollEnabled="True" SetHeight="28" HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="20">
                        <info:LinkBanner Name="LinkBanner" StyleClasses="LobbyLinks" VerticalAlignment="Center" />
                        <info:DevInfoBanner Name="DevInfoBanner" StyleClasses="LobbyLinks" VerticalAlignment="Center" />
                        <Label Name="StationTime" Access="Public" StyleClasses="WFRoundSetupMuted" VAlign="Center" />
                        <RichTextLabel Name="LobbySong" Access="Public" StyleClasses="WFRoundSetupMuted" VerticalAlignment="Center" MaxWidth="480" />
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    <PanelContainer Name="SkinScanlines" StyleClasses="LobbyScanlines" MouseFilter="Ignore" />
    <!-- WOLFGATE END -->
</lobbyUi:LobbyGui>
