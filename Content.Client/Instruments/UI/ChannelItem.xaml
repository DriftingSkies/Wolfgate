<!-- WOLFGATE(Instruments) START: wizden#41604 instrument UI overhaul and follow-ups, ported whole. -->
<Control xmlns="https://spacestation14.io"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls" HorizontalExpand="True">
    <PanelContainer Name="ItemPanel">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#00000044" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal">
            <Label Name="ChannelNumberLabel" Align="Right" HorizontalAlignment="Left" MinWidth="30" />
            <controls:VSpacer Spacing="10" />
            <Label Name="ChannelNameLabel" HorizontalAlignment="Center" />
            <controls:VSpacer HorizontalExpand="True" />
            <!-- WOLFGATE(Instruments): CheckBox stands in for upstream's SwitchButton (wizden#39161), which isn't ported. -->
            <CheckBox Name="ChannelEnableSwitchButton" HorizontalAlignment="Right" />
        </BoxContainer>
    </PanelContainer>
</Control>
<!-- WOLFGATE END -->
