<cartridges:PdaStoreAppCard xmlns="https://spacestation14.io"
                    xmlns:cartridges="clr-namespace:Content.Client._WG.PdaStorage"
                    xmlns:ui="clr-namespace:Content.Client._WG.PdaUi"
                    HorizontalExpand="True"
                    Margin="0 0 0 3">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8 5">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <AnimatedTextureRect Name="IconRect" SetSize="16 16" VerticalAlignment="Center" Visible="False"/>
            <Label Name="NameLabel" HorizontalExpand="True" VerticalAlignment="Center" Margin="6 0"/>
            <Label Name="SizeLabel" VerticalAlignment="Center" Margin="4 0"/>
            <ui:PdaButton Name="DownloadButton" VerticalAlignment="Center" Visible="False"/>
            <ui:PdaTaskProgress Name="TaskProgress" VerticalAlignment="Center" Visible="False"/>
        </BoxContainer>
        <RichTextLabel Name="DescriptionLabel" HorizontalExpand="True" Margin="0 2 0 0" Visible="False"/>
    </BoxContainer>
</cartridges:PdaStoreAppCard>
