<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               xmlns:ui="clr-namespace:Content.Client._WG.ShipAdmin"
               xmlns:spawn="clr-namespace:Content.Client._WG.ShipAdmin.Spawn"
               Title="{Loc wg-ship-admin-title}"
               MinSize="900 540"
               SetSize="1100 720">
    <BoxContainer Orientation="Vertical" SeparationOverride="4">
        <spawn:WGShipAdminSpawnPanel Name="SpawnPage" Access="Public" Visible="False" VerticalExpand="True" />
        <BoxContainer Name="ShipsPage" Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SetWidth="340" SeparationOverride="4">
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <LineEdit Name="SearchBar" PlaceHolder="{Loc wg-ship-admin-search}" HorizontalExpand="True" />
                    <Button Name="RefreshButton" Text="{Loc wg-ship-admin-refresh}" StyleClasses="ButtonSquare" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Button Name="PlayerShipsButton" Text="{Loc wg-ship-admin-filter-ships}" ToggleMode="True" StyleClasses="OpenRight" HorizontalExpand="True" />
                    <Button Name="AllGridsButton" Text="{Loc wg-ship-admin-filter-all}" ToggleMode="True" StyleClasses="OpenLeft" HorizontalExpand="True" />
                </BoxContainer>
                <ui:WGShipAdminText Name="FilterNote" />
                <ui:WGShipAdminDropdown Name="SortButton" Access="Public" HorizontalExpand="True" />
                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#141414" BorderColor="#333333" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True" Margin="2">
                        <BoxContainer Name="ShipList" Access="Public" Orientation="Vertical" SeparationOverride="2" />
                    </ScrollContainer>
                </PanelContainer>
                <Label Name="CountLabel" StyleClasses="LabelSubText" ClipText="True" />
            </BoxContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                <Label Name="NoShipLabel" Text="{Loc wg-ship-admin-none-selected}" StyleClasses="LabelSubText" Margin="8" />
                <BoxContainer Name="ShipBox" Orientation="Vertical" VerticalExpand="True" SeparationOverride="4" Visible="False">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Label Name="ShipNameLabel" Access="Public" StyleClasses="LabelHeading" ClipText="True" HorizontalExpand="True" />
                        <ContainerButton Name="HeaderJump" Access="Public">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                <ui:WGShipAdminCompass Name="HeaderCompass" />
                                <Label Name="HeaderDistance" StyleClasses="LabelSubText" SetWidth="70" Align="Right" />
                            </BoxContainer>
                        </ContainerButton>
                    </BoxContainer>
                    <ui:WGShipAdminText Name="ShipSummaryLabel" />
                    <TabContainer Name="Tabs" Access="Public" VerticalExpand="True" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" />
        <ui:WGShipAdminText Name="ResultLabel" Access="Public" />

        <!-- The window's two pages, as a full-width row of big joined buttons along the bottom. -->
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#141414" BorderColor="#333333" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" SeparationOverride="2" Margin="4">
                <Button Name="ShipsPageButton" Access="Public" Text="{Loc wg-ship-admin-page-ships}" ToggleMode="True" Pressed="True" StyleClasses="ButtonBig OpenRight" HorizontalExpand="True" MinHeight="38" />
                <Button Name="SpawnPageButton" Access="Public" Text="{Loc wg-ship-admin-page-spawn}" ToggleMode="True" StyleClasses="ButtonBig OpenLeft" HorizontalExpand="True" MinHeight="38" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
