<ui:PdaProgramRow xmlns="https://spacestation14.io"
                 xmlns:ui="clr-namespace:Content.Client._WG.PdaUi"
                 HorizontalExpand="True"
                 MinHeight="28"
                 Margin="0 0 0 2">
    <PanelContainer Name="Background"/>
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 2">
        <AnimatedTextureRect Name="IconRect" SetSize="16 16" VerticalAlignment="Center" Visible="False"/>
        <Label Name="NameLabel" HorizontalExpand="True" VerticalAlignment="Center" Margin="6 0 0 0"/>
        <Label Name="StatusLabel" VerticalAlignment="Center" Margin="4 0" Visible="False"/>
        <ui:PdaButton Name="AltButton" VerticalAlignment="Center" Margin="0 0 4 0" Visible="False"/>
        <ui:PdaButton Name="ActionButton" VerticalAlignment="Center" Visible="False"/>
    </BoxContainer>
</ui:PdaProgramRow>
