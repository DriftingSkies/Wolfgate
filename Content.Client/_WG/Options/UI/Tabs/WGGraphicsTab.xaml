<tabs:WGGraphicsTab xmlns="https://spacestation14.io"
                    xmlns:tabs="clr-namespace:Content.Client._WG.Options.UI.Tabs"
                    xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8" VerticalExpand="True">
                <Label Text="{Loc 'ui-options-display-label'}" StyleClasses="LabelKeyText"/>
                <ui:OptionDropDown Name="DropDownMaxFps" Title="{Loc 'ui-options-wg-max-fps'}" />
                <Label Text="{Loc 'ui-options-quality-label'}" StyleClasses="LabelKeyText"/>
                <ui:OptionDropDown Name="DropDownInteractionParticles" Title="{Loc 'ui-options-interaction-particles'}" ToolTip="{Loc 'ui-options-interaction-particles-tooltip'}" />
                <ui:OptionDropDown Name="DropDownWeatherQuality" Title="{Loc 'ui-options-wolf-weather-quality'}" />
                <CheckBox Name="ParallaxEnabledCheckBox" Text="{Loc 'ui-options-wg-parallax-enabled'}" />
                <CheckBox Name="RenderStarSystemCheckBox" Text="{Loc 'ui-options-render-star-system'}" />
                <CheckBox Name="BloomCheckBox" Text="{Loc 'ui-options-wg-bloom'}" />
                <ui:OptionSlider Name="BloomStrengthSlider" Title="{Loc 'ui-options-wg-bloom-strength'}" />
                <CheckBox Name="GrainCheckBox" Text="{Loc 'ui-options-wg-grain'}" />
                <Label Text="{Loc 'ui-options-wg-effects'}" StyleClasses="LabelKeyText"/>
                <CheckBox Name="HeatHazeCheckBox" Text="{Loc 'ui-options-wg-heat-haze'}" />
                <ui:OptionSlider Name="HeatHazeStrengthSlider" Title="{Loc 'ui-options-wg-heat-haze-strength'}" />
                <CheckBox Name="ShockwaveCheckBox" Text="{Loc 'ui-options-wg-shockwave'}" />
                <ui:OptionSlider Name="ShockwaveStrengthSlider" Title="{Loc 'ui-options-wg-shockwave-strength'}" />
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:WGGraphicsTab>
