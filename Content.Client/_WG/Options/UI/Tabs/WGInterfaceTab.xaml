<tabs:WGInterfaceTab xmlns="https://spacestation14.io"
                     xmlns:tabs="clr-namespace:Content.Client._WG.Options.UI.Tabs"
                     xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8" VerticalExpand="True">
                <Label Text="{Loc 'ui-options-wg-interface'}" StyleClasses="LabelKeyText"/>
                <ui:OptionDropDown Name="DropDownWolfgateStyle" Title="{Loc 'ui-options-wg-ui-style'}" />
                <CheckBox Name="WindowPopoutCheckBox" Text="{Loc 'ui-options-wg-window-popout'}" />
                <CheckBox Name="DetailedExamineCheckBox" Text="{Loc 'ui-options-detailed-examine'}" />
                <CheckBox Name="ShowNewbieTagCheckBox" Text="{Loc 'wg-newbie-option-show-tag'}" />
                <Label Text="{Loc 'ui-options-general-cursor'}" StyleClasses="LabelKeyText"/>
                <ui:OptionDropDown Name="DropDownScreentips" Title="{Loc 'ui-options-wg-screentips'}" />
                <ui:OptionColorSlider Name="ScreentipColorSlider"
                                      Title="{Loc 'ui-options-wg-screentip-color'}"
                                      Example="{Loc 'ui-options-wg-screentip-color-example'}"/>
                <CheckBox Name="OutlineCheckBox" Text="{Loc 'ui-options-wg-outline'}" />
                <CheckBox Name="CombatFaceCursorCheckBox" Text="{Loc 'ui-options-wg-combat-face-cursor'}" />
                <Label Text="{Loc 'wg-options-section-ships'}" StyleClasses="LabelKeyText"/>
                <CheckBox Name="CockpitAutoEnterCheckBox" Text="{Loc 'ui-options-wg-cockpit-auto-enter'}" />
                <CheckBox Name="DefaultNorthCheckBox" Text="{Loc 'ui-options-wg-default-north'}" />
                <CheckBox Name="RadarSmartTagsCheckBox" Text="{Loc 'ui-options-wg-radar-smart-tags'}" />
                <CheckBox Name="RadarIconsOnlyCheckBox" Text="{Loc 'ui-options-wg-radar-icons-only'}" />
                <CheckBox Name="RadarHoverRevealCheckBox" Text="{Loc 'ui-options-wg-radar-hover-reveal'}" />
                <Label Text="{Loc 'ui-options-wg-medical'}" StyleClasses="LabelKeyText"/>
                <CheckBox Name="CritHeartbeatCheckBox" Text="{Loc 'ui-options-wg-crit-heartbeat'}" />
                <CheckBox Name="DyingEffectsCheckBox" Text="{Loc 'ui-options-wg-dying-effects'}" />
                <CheckBox Name="SyntheticHudCheckBox" Text="{Loc 'ui-options-wg-synthetic-hud'}" />
                <ui:OptionSlider Name="SyntheticHudScaleSlider" Title="{Loc 'ui-options-wg-synthetic-hud-scale'}" />
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:WGInterfaceTab>
