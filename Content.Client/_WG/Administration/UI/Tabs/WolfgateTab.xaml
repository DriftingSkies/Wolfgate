<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vessel="clr-namespace:Content.Client._WG.Administration.UI.VesselSpawn"
    xmlns:internet="clr-namespace:Content.Client._WG.Administration.UI.InternetSound"
    xmlns:power="clr-namespace:Content.Client._WG.Administration.UI.GridPower"
    xmlns:ert="clr-namespace:Content.Client._WG.Administration.UI.Ert"
    xmlns:crew="clr-namespace:Content.Client._WG.NpcCrew"
    xmlns:vehiclecrew="clr-namespace:Content.Client._WG.NpcVehicleCrew"
    xmlns:encounters="clr-namespace:Content.Client._WG.Encounters"
    xmlns:planets="clr-namespace:Content.Client._WG.Planets.Administration"
    Margin="4"
    MinSize="50 50">
    <!-- The menu sizes itself for its first tab. This one grows it to fit (see the code-behind) and scrolls if it can't. -->
    <ScrollContainer HScrollEnabled="False" ReturnMeasure="True" VerticalExpand="True" HorizontalExpand="True">
        <GridContainer Columns="3">
            <cc:UICommandButton Command="wg_crew" Text="{Loc wg-crew-setup-title}" WindowType="{x:Type crew:WGCrewSetupWindow}" />
            <cc:UICommandButton Command="wg_vehiclecrew" Text="{Loc wg-vehiclecrew-panel-title}" WindowType="{x:Type vehiclecrew:WGVehicleCrewPanel}" />
            <cc:UICommandButton Command="wg_encounter" Text="{Loc wg-encounter-admin-title}" WindowType="{x:Type encounters:WGEncounterWindow}" />
            <cc:UICommandButton Command="spawnvessel" Text="{Loc wg-admin-tab-spawn-vessel}" WindowType="{x:Type vessel:VesselSpawnWindow}" />
            <cc:UICommandButton Command="playinternetsound" Text="{Loc wg-admin-tab-internet-sound}" WindowType="{x:Type internet:InternetSoundAdminWindow}" />
            <cc:CommandButton Command="rpannounce" Text="{Loc wg-announce-button}" />
            <cc:CommandButton Command="wg_defconpanel" Text="{Loc wg-defcon-panel-button}" />
            <cc:UICommandButton Command="gridpower" Text="{Loc wg-admin-tab-grid-power}" WindowType="{x:Type power:GridPowerWindow}" />
            <cc:UICommandButton Command="ertbuilder" Text="{Loc wg-admin-tab-ert}" WindowType="{x:Type ert:ErtBuilderWindow}" />
            <cc:UICommandButton Command="planetcontrol" Text="{Loc wg-admin-tab-planet-control}" WindowType="{x:Type planets:PlanetControlWindow}" />
            <cc:CommandButton Command="testdummies" Text="{Loc wg-test-dummy-button}" />
            <cc:CommandButton Command="nukedesigner" Text="{Loc wg-nuke-designer-button}" />
            <cc:CommandButton Command="shipmaster" Text="{Loc wg-ship-admin-button}" />
        </GridContainer>
    </ScrollContainer>
</Control>
