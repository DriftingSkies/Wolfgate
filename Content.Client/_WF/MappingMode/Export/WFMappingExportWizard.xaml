<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:mapping="clr-namespace:Content.Client._WF.MappingMode"
                      Title="{Loc 'wf-mapping-export-title'}"
                      MinSize="560 520"
                      SetSize="660 720">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="StepLabel" Access="Public" StyleClasses="LabelHeading" />
        <Label Name="TargetLabel" Access="Public" StyleClasses="LabelSubText" ClipText="True" />

        <!-- Step 1: Check -->
        <BoxContainer Name="CheckStep" Access="Public" Orientation="Vertical" VerticalExpand="True" SeparationOverride="6">
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{Loc 'wf-mapping-export-kind'}" VAlign="Center" />
                <Button Name="ShipKindButton" Access="Public" ToggleMode="True" Text="{Loc 'wf-mapping-export-kind-ship'}"
                        ToolTip="{Loc 'wf-mapping-export-kind-ship-tooltip'}" TooltipDelay="0" />
                <Button Name="MapKindButton" Access="Public" ToggleMode="True" Text="{Loc 'wf-mapping-export-kind-map'}"
                        ToolTip="{Loc 'wf-mapping-export-kind-map-tooltip'}" TooltipDelay="0" />
                <Button Name="GridKindButton" Access="Public" ToggleMode="True" Text="{Loc 'wf-mapping-export-kind-grid'}"
                        ToolTip="{Loc 'wf-mapping-export-kind-grid-tooltip'}" TooltipDelay="0" />
                <Control HorizontalExpand="True" />
                <Button Name="RecheckButton" Access="Public" Text="{Loc 'wf-mapping-export-recheck'}" />
            </BoxContainer>
            <RichTextLabel Name="CheckSummary" Access="Public" StyleClasses="LabelSubText" HorizontalExpand="True" />
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                <BoxContainer Name="IssueList" Access="Public" Orientation="Vertical" SeparationOverride="4" />
            </ScrollContainer>
            <RichTextLabel Name="CheckHint" Access="Public" />
        </BoxContainer>

        <!-- Step 2: Details -->
        <ScrollContainer Name="DetailsStep" Access="Public" HScrollEnabled="False" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="0 0 8 0">
                <RichTextLabel Name="DetailsMapNote" Access="Public" StyleClasses="LabelSubText" Visible="False"
                               HorizontalExpand="True" Text="{Loc 'wf-mapping-export-details-map'}" />
                <BoxContainer Name="DetailsForm" Access="Public" Orientation="Vertical" SeparationOverride="6">
                    <Label Text="{Loc 'wf-mapping-export-details-name'}" StyleClasses="LabelHeading" />
                    <LineEdit Name="NameEdit" Access="Public" />
                    <RichTextLabel Text="{Loc 'wf-mapping-export-details-name-hint'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                    <Label Name="PreviewLabel" Access="Public" StyleClasses="LabelSubText" ClipText="True" />

                    <Label Text="{Loc 'wf-mapping-export-details-description'}" StyleClasses="LabelHeading" Margin="0 6 0 0" />
                    <TextEdit Name="DescriptionEdit" Access="Public" MinHeight="90" />
                    <Label Name="DescriptionCount" Access="Public" StyleClasses="LabelSubText" />

                    <Label Text="{Loc 'wf-mapping-export-details-price'}" StyleClasses="LabelHeading" Margin="0 6 0 0" />
                    <LineEdit Name="PriceEdit" Access="Public" MinWidth="220" HorizontalAlignment="Left" />
                    <RichTextLabel Name="PriceHint" Access="Public" StyleClasses="LabelSubText" HorizontalExpand="True" />

                    <BoxContainer Orientation="Horizontal" SeparationOverride="12" Margin="0 6 0 0">
                        <BoxContainer Orientation="Vertical" SeparationOverride="4">
                            <Label Text="{Loc 'wf-mapping-export-details-category'}" StyleClasses="LabelHeading" />
                            <OptionButton Name="CategoryOption" Access="Public" MinWidth="140" />
                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="4">
                            <Label Text="{Loc 'wf-mapping-export-details-group'}" StyleClasses="LabelHeading" />
                            <OptionButton Name="GroupOption" Access="Public" MinWidth="160" />
                        </BoxContainer>
                    </BoxContainer>

                    <Label Text="{Loc 'wf-mapping-export-details-classes'}" StyleClasses="LabelHeading" Margin="0 6 0 0" />
                    <RichTextLabel Text="{Loc 'wf-mapping-export-details-classes-hint'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                    <GridContainer Name="ClassGrid" Access="Public" Columns="3" />

                    <Label Text="{Loc 'wf-mapping-export-details-engines'}" StyleClasses="LabelHeading" Margin="0 6 0 0" />
                    <CheckBox Name="EnginesAutoCheck" Access="Public" Text="{Loc 'wf-mapping-export-details-engines-auto'}" />
                    <GridContainer Name="EngineGrid" Access="Public" Columns="3" />

                    <Label Text="{Loc 'wf-mapping-export-details-access'}" StyleClasses="LabelHeading" Margin="0 6 0 0" />
                    <LineEdit Name="AccessEdit" Access="Public" MinWidth="220" HorizontalAlignment="Left" />
                    <RichTextLabel Text="{Loc 'wf-mapping-export-details-access-hint'}" StyleClasses="LabelSubText" HorizontalExpand="True" />

                    <CheckBox Name="RequireCrewCheck" Access="Public" Text="{Loc 'wf-mapping-export-details-require-crew'}"
                              Margin="0 6 0 0" />
                </BoxContainer>
            </BoxContainer>
        </ScrollContainer>

        <!-- Step 3: Package -->
        <BoxContainer Name="PackageStep" Access="Public" Orientation="Vertical" VerticalExpand="True" SeparationOverride="6">
            <RichTextLabel Name="PackageSummary" Access="Public" />
            <RichTextLabel Name="SaveFirstLabel" Access="Public" StyleClasses="LabelSubText" Visible="False"
                           HorizontalExpand="True" Text="{Loc 'wf-mapping-export-package-save-first'}" />
            <mapping:WFMappingDownloadTargetPicker Name="Target" Access="Public" />
            <RichTextLabel Name="SaveToHint" Access="Public" StyleClasses="LabelSubText" Visible="False" HorizontalExpand="True" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Button Name="PackageButton" Access="Public" Text="{Loc 'wf-mapping-export-package-button'}" />
                <Label Name="PackageStatus" Access="Public" VAlign="Center" HorizontalExpand="True" ClipText="True" />
            </BoxContainer>
            <mapping:WFMappingDownloadRow Name="DownloadRow" Access="Public" />
            <Control VerticalExpand="True" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 6 0 0">
            <Button Name="BackButton" Access="Public" Text="{Loc 'wf-mapping-export-back'}" />
            <Control HorizontalExpand="True" />
            <Button Name="NextButton" Access="Public" Text="{Loc 'wf-mapping-export-next'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
