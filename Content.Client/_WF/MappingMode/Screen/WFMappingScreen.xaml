<screen:WFMappingScreen xmlns="https://spacestation14.io"
                        xmlns:screen="clr-namespace:Content.Client._WF.MappingMode.Screen"
                        xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                        xmlns:menuBar="clr-namespace:Content.Client.UserInterface.Systems.MenuBar.Widgets"
                        xmlns:chat="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
                        xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                        Name="WFMappingHud"
                        VerticalExpand="False"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center">
    <SplitContainer Name="ScreenSplit" HorizontalExpand="True" VerticalExpand="True" SplitWidth="2"
                    StretchDirection="BottomRight">
        <PanelContainer Name="LeftDock" SetWidth="380" MinWidth="260" VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#16161A" />
            </PanelContainer.PanelOverride>
            <BoxContainer Name="PaletteHost" Access="Public" Orientation="Vertical"
                          HorizontalExpand="True" VerticalExpand="True" />
        </PanelContainer>
        <SplitContainer Name="RightSplit" HorizontalExpand="True" VerticalExpand="True" SplitWidth="2"
                        StretchDirection="TopLeft">
            <LayoutContainer Name="ViewportContainer" Access="Public" HorizontalExpand="True" VerticalExpand="True">
                <controls:MainViewport Name="MainViewport" />
                <menuBar:GameTopMenuBar Name="TopBar" Access="Protected" />
                <BoxContainer Name="QuickBarHost" Access="Public" Orientation="Horizontal" />
                <BoxContainer Name="StatusHost" Access="Public" Orientation="Vertical" MouseFilter="Ignore" />
                <screen:WFMappingModeBar Name="ModeBar" Access="Public" />
            </LayoutContainer>
            <PanelContainer Name="RightDock" SetWidth="360" MinWidth="280" VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#16161A" />
                </PanelContainer.PanelOverride>
                <SplitContainer Name="RightColumn" Orientation="Vertical" VerticalExpand="True" SplitWidth="2"
                                StretchDirection="TopLeft">
                    <TabContainer Name="RightTabs" Access="Public" VerticalExpand="True" HorizontalExpand="True">
                        <BoxContainer Name="PropertiesHost" Access="Public" Orientation="Vertical"
                                      HorizontalExpand="True" VerticalExpand="True" />
                        <BoxContainer Name="ToolsHost" Access="Public" Orientation="Vertical"
                                      HorizontalExpand="True" VerticalExpand="True" />
                        <BoxContainer Name="LayersHost" Access="Public" Orientation="Vertical"
                                      HorizontalExpand="True" VerticalExpand="True" />
                        <BoxContainer Name="TemplateHost" Access="Public" Orientation="Vertical"
                                      HorizontalExpand="True" VerticalExpand="True" />
                        <BoxContainer Name="KeysHost" Access="Public" Orientation="Vertical"
                                      HorizontalExpand="True" VerticalExpand="True" />
                    </TabContainer>
                    <chat:ChatBox Name="Chat" Access="Protected" HorizontalExpand="True" VerticalExpand="True"
                                  MinSize="0 120" />
                </SplitContainer>
            </PanelContainer>
        </SplitContainer>
    </SplitContainer>
</screen:WFMappingScreen>
