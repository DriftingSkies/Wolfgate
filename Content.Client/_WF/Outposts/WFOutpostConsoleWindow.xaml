<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:outposts="clr-namespace:Content.Client._WF.Outposts"
                      xmlns:access="clr-namespace:Content.Client._WF.ShipAccess"
                      MinSize="520 360"
                      SetSize="760 600"
                      Title="{Loc 'wf-outpost-console-title'}">
    <TabContainer Name="Tabs" Margin="8">
        <BoxContainer Name="OverviewTab" Orientation="Vertical" Margin="8" SeparationOverride="8">
            <Label Text="{Loc 'wf-outpost-console-name'}" StyleClasses="LabelSubHeading"/>
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="NameEdit" HorizontalExpand="True"/>
                <Button Name="RenameButton" Text="{Loc 'wf-outpost-console-rename'}"/>
            </BoxContainer>
            <GridContainer Columns="2" HSeparationOverride="12">
                <Label Text="{Loc 'wf-outpost-console-owner'}" StyleClasses="LabelSecondaryColor"/>
                <Label Name="OwnerLabel"/>
                <Label Text="{Loc 'wf-outpost-console-tiles'}" StyleClasses="LabelSecondaryColor"/>
                <Label Name="TilesLabel"/>
                <Label Text="{Loc 'wf-outpost-console-entities'}" StyleClasses="LabelSecondaryColor"/>
                <Label Name="EntitiesLabel"/>
                <Label Name="RaidTitle" Text="{Loc 'wf-outpost-console-raids'}" StyleClasses="LabelSecondaryColor" Visible="False"/>
                <Label Name="RaidLabel" Visible="False"/>
            </GridContainer>
        </BoxContainer>
        <BoxContainer Name="SavesTab" Orientation="Vertical" Margin="8" SeparationOverride="8">
            <RichTextLabel Name="SavesHint"/>
            <BoxContainer Name="PendingBox" Orientation="Horizontal" SeparationOverride="8" Visible="False">
                <Label Name="PendingLabel" HorizontalExpand="True" ClipText="True"/>
                <Button Name="CancelLoadButton" Text="{Loc 'wf-outpost-console-cancel-load'}"/>
            </BoxContainer>
            <Label Name="ReadingLabel" Text="{Loc 'wf-outpost-console-saves-reading'}" StyleClasses="LabelSecondaryColor"/>
            <BoxContainer Name="SlotsBox" Orientation="Vertical" SeparationOverride="6"/>
            <outposts:WFOutpostPreviewBox Name="PreviewBox" VerticalExpand="True"/>
        </BoxContainer>
        <BoxContainer Name="TradeTab" Orientation="Vertical" Margin="8" SeparationOverride="8">
            <GridContainer Columns="2" HSeparationOverride="12">
                <Label Text="{Loc 'wf-outpost-trade-hub'}" StyleClasses="LabelSecondaryColor"/>
                <Label Name="HubLabel"/>
                <Label Text="{Loc 'wf-outpost-trade-balance'}" StyleClasses="LabelSecondaryColor"/>
                <Label Name="BalanceLabel"/>
            </GridContainer>
            <Label Name="OrdersHeader" StyleClasses="LabelSubHeading"/>
            <BoxContainer Name="OrdersBox" Orientation="Vertical" SeparationOverride="2"/>
            <LineEdit Name="TradeSearch" PlaceHolder="{Loc 'wf-outpost-trade-search'}"/>
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="CatalogueBox" Orientation="Vertical" SeparationOverride="4"/>
            </ScrollContainer>
        </BoxContainer>
        <BoxContainer Name="SellTab" Orientation="Vertical" Margin="8" SeparationOverride="8">
            <RichTextLabel Name="SellHint"/>
            <GridContainer Columns="2" HSeparationOverride="12">
                <Label Text="{Loc 'wf-outpost-sell-value'}" StyleClasses="LabelSecondaryColor"/>
                <Label Name="SellValueLabel"/>
            </GridContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <controls:ConfirmButton Name="SellButton" Text="{Loc 'wf-outpost-sell-button'}"/>
                <CheckBox Name="SellAtRoundEndCheck" Text="{Loc 'wf-outpost-sell-round-end-toggle'}"/>
            </BoxContainer>
            <Label Text="{Loc 'wf-outpost-offer-header'}" StyleClasses="LabelSubHeading"/>
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <OptionButton Name="BuyerOption" HorizontalExpand="True"/>
                <LineEdit Name="OfferPriceEdit" MinWidth="120" PlaceHolder="{Loc 'wf-outpost-offer-price'}"/>
                <Button Name="OfferButton" Text="{Loc 'wf-outpost-offer-button'}"/>
                <Button Name="RefreshBuyersButton" Text="{Loc 'wf-outpost-offer-refresh'}"/>
            </BoxContainer>
            <BoxContainer Name="OfferBox" Orientation="Horizontal" SeparationOverride="8" Visible="False">
                <Label Name="OfferLabel" HorizontalExpand="True" ClipText="True"/>
                <Button Name="WithdrawOfferButton" Text="{Loc 'wf-outpost-offer-withdraw'}"/>
            </BoxContainer>
        </BoxContainer>
        <access:ShipAccessScreen Name="AccessTab" Access="Public" Margin="8"/>
    </TabContainer>
</controls:FancyWindow>
