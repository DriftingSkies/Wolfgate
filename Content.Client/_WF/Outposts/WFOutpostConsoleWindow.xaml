<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:outposts="clr-namespace:Content.Client._WF.Outposts"
                      xmlns:access="clr-namespace:Content.Client._WF.ShipAccess"
                      xmlns:colonies="clr-namespace:Content.Client._WF.Colonies"
                      xmlns:hideouts="clr-namespace:Content.Client._WF.Hideouts"
                      MinSize="1000 600"
                      SetSize="1120 720"
                      Title="{Loc 'wf-outpost-console-title'}">
    <TabContainer Name="Tabs" Margin="8">
        <BoxContainer Name="OverviewTab" Orientation="Horizontal" Margin="8" SeparationOverride="8">
            <PanelContainer StyleClasses="AngleRect" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4">
                    <outposts:WFOutpostMapControl Name="OutpostMap" HorizontalExpand="True" VerticalExpand="True" MinSize="280 280"/>
                    <BoxContainer Name="MapLegend" Orientation="Horizontal" SeparationOverride="14" HorizontalAlignment="Center"/>
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Vertical" MinWidth="300" MaxWidth="340" SeparationOverride="8">
                <PanelContainer StyleClasses="AngleRect">
                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="4">
                        <Label Text="{Loc 'wf-outpost-console-name'}" StyleClasses="LabelSubText"/>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <LineEdit Name="NameEdit" HorizontalExpand="True"/>
                            <Button Name="RenameButton" Text="{Loc 'wf-outpost-console-rename'}" StyleClasses="OpenBoth"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="0 4 0 0">
                            <Label Text="{Loc 'wf-outpost-console-owner'}" StyleClasses="LabelSecondaryColor"/>
                            <Label Name="OwnerLabel" HorizontalExpand="True" Align="Right" ClipText="True"/>
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="AngleRect">
                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="4">
                        <Label Text="{Loc 'wf-outpost-console-capacity'}" StyleClasses="LabelHeading"/>
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'wf-outpost-console-tiles'}" StyleClasses="LabelSecondaryColor" HorizontalExpand="True"/>
                            <Label Name="TilesLabel"/>
                        </BoxContainer>
                        <ProgressBar Name="TilesBar" MinValue="0" MaxValue="1" MinHeight="10" HorizontalExpand="True"/>
                        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                            <Label Text="{Loc 'wf-outpost-console-entities'}" StyleClasses="LabelSecondaryColor" HorizontalExpand="True"/>
                            <Label Name="EntitiesLabel"/>
                        </BoxContainer>
                        <ProgressBar Name="EntitiesBar" MinValue="0" MaxValue="1" MinHeight="10" HorizontalExpand="True"/>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="AngleRect">
                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="4">
                        <Label Text="{Loc 'wf-outpost-console-status'}" StyleClasses="LabelHeading"/>
                        <Label Text="{Loc 'wf-outpost-trade-hub'}" StyleClasses="LabelSecondaryColor"/>
                        <Label Name="OverviewHubLabel" ClipText="True"/>
                        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                            <Label Text="{Loc 'wf-outpost-console-orders'}" StyleClasses="LabelSecondaryColor" HorizontalExpand="True"/>
                            <Label Name="OverviewOrdersLabel"/>
                        </BoxContainer>
                        <Label Name="RaidTitle" Text="{Loc 'wf-outpost-console-raids'}" StyleClasses="LabelSecondaryColor" Visible="False" Margin="0 4 0 0"/>
                        <Label Name="RaidLabel" Visible="False" ClipText="True"/>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Name="SavesTab" Orientation="Vertical" Margin="8" SeparationOverride="8">
            <PanelContainer StyleClasses="AngleRect">
                <RichTextLabel Name="SavesHint" Margin="10 6"/>
            </PanelContainer>
            <PanelContainer Name="PendingBox" StyleClasses="AngleRect" Visible="False">
                <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="10 6">
                    <Label Name="PendingLabel" HorizontalExpand="True" ClipText="True"/>
                    <Button Name="CancelLoadButton" Text="{Loc 'wf-outpost-console-cancel-load'}" StyleClasses="Caution"/>
                </BoxContainer>
            </PanelContainer>
            <SplitContainer Name="SavesSplit" Orientation="Horizontal" VerticalExpand="True">
                <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" SeparationOverride="6">
                        <Label Name="ReadingLabel" Text="{Loc 'wf-outpost-console-saves-reading'}" StyleClasses="LabelSecondaryColor"/>
                        <BoxContainer Name="SlotsBox" Orientation="Vertical" SeparationOverride="6"/>
                    </BoxContainer>
                </ScrollContainer>
                <PanelContainer StyleClasses="AngleRect" HorizontalExpand="True" VerticalExpand="True">
                    <outposts:WFOutpostPreviewBox Name="PreviewBox" Margin="6" VerticalExpand="True"/>
                </PanelContainer>
            </SplitContainer>
        </BoxContainer>
        <BoxContainer Name="TradeTab" Orientation="Vertical" Margin="8" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <PanelContainer StyleClasses="AngleRect" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="10 6">
                        <Label Text="{Loc 'wf-outpost-trade-hub'}" StyleClasses="LabelSubText"/>
                        <Label Name="HubLabel" ClipText="True"/>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="AngleRect" MinWidth="200">
                    <BoxContainer Orientation="Vertical" Margin="10 6">
                        <Label Text="{Loc 'wf-outpost-trade-balance'}" StyleClasses="LabelSubText"/>
                        <Label Name="BalanceLabel" StyleClasses="LabelBig"/>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
            <PanelContainer StyleClasses="AngleRect">
                <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                    <Label Name="OrdersHeader" StyleClasses="LabelHeading"/>
                    <BoxContainer Name="OrdersBox" Orientation="Vertical" SeparationOverride="4"/>
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <Label Text="{Loc 'wf-outpost-trade-catalogue'}" StyleClasses="LabelHeading" HorizontalExpand="True"/>
                <LineEdit Name="TradeSearch" MinWidth="260" PlaceHolder="{Loc 'wf-outpost-trade-search'}"/>
            </BoxContainer>
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="CatalogueBox" Orientation="Vertical" SeparationOverride="4"/>
            </ScrollContainer>
        </BoxContainer>
        <BoxContainer Name="SellTab" Orientation="Vertical" Margin="8" SeparationOverride="8">
            <PanelContainer StyleClasses="AngleRect">
                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                    <RichTextLabel Name="SellHint"/>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'wf-outpost-sell-value'}" StyleClasses="LabelSecondaryColor"/>
                        <Label Name="SellValueLabel" StyleClasses="LabelBig" HorizontalExpand="True"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <controls:ConfirmButton Name="SellButton" Text="{Loc 'wf-outpost-sell-button'}" StyleClasses="Caution"/>
                        <CheckBox Name="SellAtRoundEndCheck" Text="{Loc 'wf-outpost-sell-round-end-toggle'}"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer StyleClasses="AngleRect">
                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                    <Label Text="{Loc 'wf-outpost-offer-header'}" StyleClasses="LabelHeading"/>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                        <OptionButton Name="BuyerOption" HorizontalExpand="True"/>
                        <LineEdit Name="OfferPriceEdit" MinWidth="120" PlaceHolder="{Loc 'wf-outpost-offer-price'}"/>
                        <Button Name="OfferButton" Text="{Loc 'wf-outpost-offer-button'}"/>
                        <Button Name="RefreshBuyersButton" Text="{Loc 'wf-outpost-offer-refresh'}"/>
                    </BoxContainer>
                    <BoxContainer Name="OfferBox" Orientation="Horizontal" SeparationOverride="8" Visible="False">
                        <Label Name="OfferLabel" HorizontalExpand="True" ClipText="True"/>
                        <Button Name="WithdrawOfferButton" Text="{Loc 'wf-outpost-offer-withdraw'}"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <colonies:WFColonyDevelopmentPanel Name="DevelopmentTab" Access="Public"/>
        <access:ShipAccessScreen Name="AccessTab" Access="Public" Margin="8"/>
        <hideouts:WFHideoutPanel Name="HideoutTab" Access="Public"/>
    </TabContainer>
</controls:FancyWindow>
