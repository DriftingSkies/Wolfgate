<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
            xmlns:dtabs="clr-namespace:Content.Client._DV.Options.UI.Tabs"
            xmlns:wgui="clr-namespace:Content.Client._WG.Options.UI"
            Title="{Loc 'ui-options-title'}"
            MinSize="800 450">
    <!-- WOLFGATE(Options) START: settings search bar above the tabs -->
    <BoxContainer Orientation="Vertical">
    <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
        <LineEdit Name="WgSearchBar" PlaceHolder="{Loc 'wg-options-search'}" HorizontalExpand="True" />
        <Label Name="WgSearchEmpty" Text="{Loc 'wg-options-search-none'}" StyleClasses="LabelSubText" Margin="8 0 0 0" Visible="False" />
    </BoxContainer>
    <!-- WOLFGATE END -->
    <!-- WOLFGATE(Options) START: SS14 and Wolfgate master tabs (xmlns:wgui), the stock tabs on the first page -->
    <wgui:WGOptionsMasterStrip Name="WgMasterStrip" Margin="0 0 0 4" />
    <TabContainer Name="WgMaster" TabsVisible="False" VerticalExpand="True">
    <!-- WOLFGATE END -->
    <TabContainer Name="Tabs" Access="Public" VerticalExpand="True"> <!-- WOLFGATE(Options): VerticalExpand under the search bar -->
        <tabs:MiscTab Name="MiscTab" />
        <tabs:GraphicsTab Name="GraphicsTab" />
        <tabs:KeyRebindTab Name="KeyRebindTab" />
        <tabs:AudioTab Name="AudioTab" />
        <tabs:AccessibilityTab Name="AccessibilityTab" />
        <tabs:AdminOptionsTab Name="AdminOptionsTab" />
        <!-- WOLFGATE(Options) START: Delta-V's Extra tab is replaced by the Wolfgate master tab, which carries its setting -->
        <!-- <dtabs:DeltaTab Name="ExtraTab" /> --> <!-- Delta-V -->
        <!-- WOLFGATE END -->
    </TabContainer>
    <!-- WOLFGATE(Options) START: the Wolfgate master tab -->
    <wgui:WolfgateOptionsTabs Name="WolfgateTabs" Access="Public" />
    </TabContainer>
    <!-- WOLFGATE END -->
    </BoxContainer> <!-- WOLFGATE(Options): settings search bar -->
</DefaultWindow>
